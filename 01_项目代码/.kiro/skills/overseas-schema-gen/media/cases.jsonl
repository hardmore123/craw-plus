# media/cases.jsonl — 媒体评测站接入经验日志
# 格式：每行一条JSON，字段：code/entry_url/date/verdict/signals/solution/result/lesson/playbook
# verdict: success(100%评分+优缺点) / partial(有数据但缺评分) / needs_human(付费墙) / blocked(WAF封) / needs_handwritten(需per-site选择器)
# 沉淀原则：只留对未来有用的操作结论（决策+why+可执行命令），与既有条目重复则合并

{"code":"techfi_nl","entry_url":"https://techfi.nl/televisies","date":"2026-10-01","verdict":"success","signals":{"jsonld_type":"@graph含完整schema.org Review(Review+Product+Article+Person)","rating_location":"reviewRating.ratingValue=8/10","pros":"positiveNotes.itemListElement[].name(8-10条)","cons":"negativeNotes.itemListElement[].name(3-7条)","product":"Product.name+brand+aggregateRating","article":"Article.headline+datePublished+author","review_list_selector":"href含review/test的链接"},"solution":{"extract_mode":"jsonld_review","rating_path":"reviewRating.ratingValue","pros_path":"positiveNotes.itemListElement","cons_path":"negativeNotes.itemListElement","model_regex":"\\b(\\d{2,3}[A-Z]{1,4}\\d{2,4}[A-Z]{0,3})\\b","rating_scale":"0-10"},"result":{"total":"84条评测(34品牌)","rated":"84/84=100%","with_notes":"84/84=100%","categories":"TV/耳机/音箱/显示器/投影仪/手机"},"lesson":"techfi_nl是JSON-LD Review黄金标准:@graph含完整Review+Product+positiveNotes/negativeNotes,评分0-10,优缺点为ItemList结构。全品类84条100%有评分+优缺点。扩展时从首页导航找所有品类入口(/televisies/monitoren等),逐品类搜review链接。","playbook":"jsonld_review"}

{"code":"techradar_uk","entry_url":"https://www.techradar.com/televisions/reviews","date":"2026-10-02","verdict":"partial","signals":{"jsonld_type":"Product内嵌Review(非顶层)","rating_location":"Product.review.reviewRating.ratingValue=5/5","needs_playwright":true,"http_timeout":true,"list_url":"/televisions/reviews含分页page/2"},"solution":{"extract_mode":"jsonld_product","rating_path":"Product.review.reviewRating.ratingValue","needs_browser":true,"nav_timeout_ms":25000},"result":{"total":"4条","rated":"2/4=50%","with_notes":"0/4"},"lesson":"techradar_uk:纯HTTP超时需Playwright。JSON-LD评分在Product内嵌Review中(非顶层@type=Review),v2提取需检查Product.review。列表页用/televisions/reviews含分页。仅部分文章有Review结构。","playbook":"jsonld_product"}

{"code":"which_uk","entry_url":"https://www.which.co.uk/reviews/televisions","date":"2026-10-02","verdict":"needs_human","signals":{"jsonld_type":"Product(无Review)","rating_location":"付费墙后","product":"Product.name+brand可见","rating_hidden":true},"solution":{"extract_mode":"jsonld_product_only","needs_login":true},"result":{"total":"12条","rated":"0/12","with_notes":"0/12"},"lesson":"which_uk:JSON-LD有Product(产品名+品牌)但评分在付费墙后,需Which?会员登录态。适合用storage_state持久化登录态后抓取。","playbook":"jsonld_product_only"}

{"code":"techzilla_it","entry_url":"https://www.techzilla.it/recensioni/","date":"2026-10-01","verdict":"success","signals":{"jsonld_type":"Review","rating_location":"reviewRating.ratingValue","http_accessible":true},"solution":{"extract_mode":"jsonld_review","rating_scale":"0-10"},"result":{"total":"10条","rated":"10/10=100%","with_notes":"0/10"},"lesson":"techzilla_it:HTTP可达,JSON-LD有评分(0-10)但无positiveNotes/negativeNotes结构,只有评分无优缺点。","playbook":"jsonld_review"}

{"code":"connect_de","entry_url":"https://www.connect.de/tv-heimkino/testbericht/","date":"2026-10-02","verdict":"needs_handwritten","signals":{"jsonld_type":"无","rating_location":"正文Fazit段(德国1-5反序,无结构化标签)","title_has_model":"标题含型号(Samsung GQ65S90H im Test)","article_links":"href=testbericht/*.html"},"solution":{"extract_mode":"html","rating_regex":"德国评分(1=sehr gut 5=mangelhaft)嵌在正文无CSS class","model_from_url":"URL slug含型号(如samsung-gq65s90h-test)","needs_per_site_selector":true},"result":{"total":"14条","rated":"0/14","with_notes":"0/14"},"lesson":"connect_de:23篇评测文章标题含型号+品牌,但无JSON-LD,评分3,5嵌在Fazit段正文无结构化标签。需per-site选择器或NLP提取德国评分(反序1=最好)。URL需用列表页实际链接,猜的URL会重定向到新闻页。","playbook":"html_fallback"}

