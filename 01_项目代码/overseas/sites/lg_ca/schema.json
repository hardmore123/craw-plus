{
  "anchor": "h1",
  "search": {
    "container": "a[href*='/tv-soundbars/']",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 5000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 60,
      "fallback_per_model": true
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "meta[itemprop='brand']"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "selectors": [
        "input[name='resourceModelCode']",
        "[data-sku]",
        "[itemprop='model']"
      ],
      "attr": "value",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "input[name='resourceModelCode']",
        "[data-sku]",
        "[itemprop='sku']"
      ],
      "attr": "value",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "none"
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "selectors": [
        "[itemprop='ratingValue']",
        "[class*='rating-value']",
        "[class*='avg-rating']"
      ],
      "attr": "content",
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "selectors": [
        "[itemprop='reviewCount']",
        "[class*='review-count']",
        "[class*='total-review']"
      ],
      "attr": "content",
      "transform": "int"
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "[data-testid*='price']",
        "[itemprop='price']",
        "meta[itemprop='price']",
        "[class*='price']:not([class*='old'])",
        ".price:not(.old-price)",
        ".product-price"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']",
        "meta[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "default": "CAD"
    },
    "list_price": {
      "selectors": [
        "[class*='old-price']",
        "[class*='original-price']",
        "[class*='was-price']",
        "s",
        "del"
      ],
      "transform": "money"
    },
    "raw_text": {
      "selectors": [
        "[data-testid*='price']",
        "[itemprop='price']",
        ".product-price"
      ],
      "transform": "clean_text"
    }
  }
}