{
  "anchor": "h1, script[type='application/ld+json']",
  "search": {
    "container": "a[href*='/product/'], .product-card, [data-product-id]",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 5000,
    "scroll_passes": 3,
    "batch": {
      "keyword_template": "{brand} {model}",
      "threshold": 10,
      "max_candidates": 60,
      "max_pages": 20,
      "max_search_failures": 2,
      "min_candidates": 5,
      "retries": 3
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "[data-testid*='price']",
        "[itemprop='price']",
        "meta[itemprop='price']",
        "[class*='price']:not([class*='old'])",
        ".price:not(.old-price)",
        ".product-price"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']",
        "meta[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "default": "EUR"
    },
    "list_price": {
      "selectors": [
        "[class*='old-price']",
        "[class*='original-price']",
        "[class*='was-price']",
        "s",
        "del"
      ],
      "transform": "money"
    },
    "raw_text": {
      "selectors": [
        "[data-testid*='price']",
        "[itemprop='price']",
        ".product-price"
      ],
      "transform": "clean_text"
    },
    "jsonld": "offers.price",
    "selectors": [
      "[class*='price']",
      "[data-testid*='price']",
      "[data-price]",
      ".price",
      ".product-price",
      "[itemprop='price']",
      "meta[itemprop='price']"
    ]
  },
  "product": {
    "title": {
      "selectors": [
        "h1"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "meta[itemprop='brand']",
        "[data-testid*='brand']"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "selectors": [
        "[itemprop='model']",
        "[data-testid*='model']"
      ],
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[itemprop='sku']",
        "meta[itemprop='sku']"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "specs": [],
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 60,
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "min_core_len": 3
    },
    "reject": {
      "title_contains_any": [
        "soundbar",
        "sound bar",
        "projektor",
        "projector",
        "wandhalterung",
        "halterung",
        "wall mount",
        "mount",
        "bracket",
        "stand",
        "standfuß",
        "stativ",
        "kabel",
        "cable",
        "adapter",
        "charger",
        "lader",
        "fernbedienung",
        "remote",
        "control",
        "case",
        "cover",
        "protector",
        "screen protector",
        "zubehör",
        "accessory",
        "accessories",
        "screw",
        "schraube",
        "speaker",
        "lautsprecher"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "reviews": {
    "container": "[itemprop='review'], [class*='review-item'], [data-testid*='review'], [data-hook='review'], [class*='review-card']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id",
        "self_attr_alt": "data-review-id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']",
          "[class*='rating']",
          "[class*='star']",
          "[data-hook*='rating']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']",
          "[itemprop='name']",
          "[data-hook*='reviewTitle']",
          "h3",
          "h4"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']",
          "[class*='review-text']",
          "[data-hook*='reviewText']",
          "[data-hook*='review-body']",
          "p"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']",
          "[class*='author']",
          "[class*='reviewer']",
          ".a-profile-name"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']",
          "time",
          "[class*='review-date']",
          "[data-hook*='review-date']"
        ],
        "attr": "datetime",
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "limit": 5
      }
    }
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "selectors": [
        "[itemprop='ratingValue']",
        "[class*='rating-value']",
        "[class*='avg-rating']"
      ],
      "attr": "content",
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "selectors": [
        "[itemprop='reviewCount']",
        "[class*='review-count']",
        "[class*='total-review']"
      ],
      "attr": "content",
      "transform": "int"
    }
  }
}