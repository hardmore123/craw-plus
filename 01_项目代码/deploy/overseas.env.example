# 复制到服务器后改名为 overseas.env，按实际情况填写
# systemd 通过 EnvironmentFile 读取；不要把本文件的真实副本提交 Git

# ---------- 路径（一般不用改）----------
# OVERSEAS_DATA_DIR=/home/hisense/pro/overseas/data
# OVERSEAS_DB_PATH=/home/hisense/pro/overseas/data/overseas.db

# ---------- 浏览器：服务器访问不了 Playwright CDN，必须用离线 Chrome ----------
OVERSEAS_BROWSER_EXECUTABLE=/home/hisense/pro/overseas/.browser/chrome-linux64/chrome
OVERSEAS_HEADLESS=true
OVERSEAS_NAV_TIMEOUT=60
# 页面加载后等待 networkidle 的稳定时间（秒）
OVERSEAS_SETTLE=4

# ---------- 代理：★ 关键 ----------
# 实测服务器 10.18.87.51 直连 amazon.ca 超时，加拿大零售站 8/14 完全不通。
# 没有出海线路时，L3 站点（Amazon/Walmart/BestBuy）在服务器上跑不通。
# 有代理就填，例如：
# OVERSEAS_PROXY=http://127.0.0.1:7890
OVERSEAS_PROXY=

# ---------- 抓取节流（强防护站点宁慢不封）----------
OVERSEAS_MIN_INTERVAL=8
OVERSEAS_JITTER=4
OVERSEAS_MAX_RETRIES=2

# ---------- 缓存 / 存档 ----------
OVERSEAS_CACHE_ENABLED=true
OVERSEAS_CACHE_TTL=86400
# 排查抽取问题时可临时打开，会占磁盘
OVERSEAS_SAVE_RAW=false

# ---------- 网评 AI（可选；不启用时仍可使用本地 NLLB/Argos）----------
# HiGPT OpenAI-compatible 网关；user_key 按网关约定作为 query 参数发送。
OVERSEAS_XINGHAI_BASE_URL=https://inner-apisix.hisense.com/higpt-new/v1
# 若运行环境配置了 HTTPS_PROXY，确保内网域名直连：
# NO_PROXY=inner-apisix.hisense.com
OVERSEAS_XINGHAI_MODEL=xinghai-ultra
OVERSEAS_XINGHAI_API_KEY=
OVERSEAS_XINGHAI_USER_KEY=
OVERSEAS_XINGHAI_TIMEOUT=90
OVERSEAS_XINGHAI_MAX_RETRIES=2
OVERSEAS_XINGHAI_MAX_WORKERS=2
OVERSEAS_XINGHAI_SSL_VERIFY=true
OVERSEAS_XINGHAI_FALLBACK_ENGINE=nllb

# ---------- 语言 / 编码（systemd 下 LANG 默认为空，中文会乱码）----------
LANG=C.UTF-8
LC_ALL=C.UTF-8
