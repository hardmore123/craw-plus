{
  "_comment": "Walmart 墨西哥抽取规则。选择器/JSON-LD 为『以实测为准』初值，DOM 改版只改本文件。价格与评价同在商品页抽取（同步）。货币走 currency_mx。JSON-LD/内嵌 __NEXT_DATA__ 为最可靠兜底。强防护，先小样验证再开启。",
  "anchor": "h1, [data-testid='product-title']",

  "search": {
    "container": "[data-item-id], [data-testid*='product'], div[data-automation-id*='product']",
    "sku": { "selectors": ["a[href*='/ip/']"], "attr": "href" },
    "title": { "selectors": ["[data-automation-id='product-title']", "span[data-automation-id*='name']", "a[href*='/ip/']"] },
    "url": { "selectors": ["a[href*='/ip/']"], "attr": "href" }
  },

  "product": {
    "title": { "selectors": ["h1", "[data-testid='product-title']", "[itemprop='name']"], "transform": "clean_text" },
    "brand": { "selectors": ["[itemprop='brand']", "[data-testid*='brand']"], "transform": "brand", "jsonld": "brand.name" },
    "model": { "selectors": ["[itemprop='model']", "[itemprop='mpn']"], "transform": "clean_text", "jsonld": "model" },
    "size": { "selectors": ["h1", "[data-testid='product-title']"], "transform": "size_inch" }
  },

  "price": {
    "price": { "selectors": ["[itemprop='price']", "[data-testid*='price'] span", "span[data-automation-id='product-price']"], "transform": "money", "jsonld": "offers.price" },
    "currency": { "selectors": ["[itemprop='priceCurrency']", "[data-testid*='price']"], "transform": "currency_mx", "jsonld": "offers.priceCurrency" },
    "list_price": { "selectors": ["[data-testid*='list-price']", "s", "del"], "transform": "money" },
    "in_stock": { "selectors": ["[data-testid*='availability']", "button[data-automation-id*='add-to-cart']"], "transform": "in_stock", "jsonld": "offers.availability" },
    "raw_text": { "selectors": ["[data-testid*='price']", "[itemprop='price']"], "transform": "clean_text" }
  },

  "specs": [
    { "type": "table", "container": "[data-testid*='spec'] tr, table.specifications tr", "key": "th", "value": "td", "limit": 120 },
    { "type": "kvlist", "container": "[data-testid*='spec'] li", "limit": 120 }
  ],

  "summary": {
    "avg_rating": { "selectors": ["[itemprop='ratingValue']", "[data-testid*='rating']"], "transform": "rating", "jsonld": "aggregateRating.ratingValue" },
    "total_count": { "selectors": ["[itemprop='reviewCount']", "[data-testid*='review-count']"], "transform": "int", "jsonld": "aggregateRating.reviewCount" }
  },

  "reviews": {
    "container": "[data-testid*='review'], article[class*='review'], [itemprop='review']",
    "limit": 40,
    "fields": {
      "review_key": { "self_attr": "id" },
      "rating": { "selectors": ["[data-testid*='rating']", "[itemprop='ratingValue']"], "transform": "rating" },
      "title": { "selectors": ["[data-testid*='review-title']", "[itemprop='name']"], "transform": "clean_text" },
      "body": { "selectors": ["[data-testid*='review-text']", "[itemprop='reviewBody']"], "transform": "clean_text" },
      "author": { "selectors": ["[data-testid*='author']", "[itemprop='author']"], "transform": "clean_text" },
      "review_date": { "selectors": ["[data-testid*='date']", "[itemprop='datePublished']"], "transform": "clean_text" },
      "helpful_count": { "selectors": ["[data-testid*='helpful']"], "transform": "int" },
      "review_url": { "selectors": ["a[href*='/ip/']"], "attr": "href" }
    },
    "media": {
      "images": { "selector": "[data-testid*='review'] img", "attr": "src", "exclude": ["avatar", "icon"], "limit": 30 },
      "videos": { "selector": "[data-testid*='review'] video source", "attr": "src", "limit": 10 }
    }
  }
}
