{
  "_comment": "El Palacio de Hierro 墨西哥抽取规则（2026-09-14 浏览器单页实测）。搜索由 adapter 从 JSON-LD ItemList 发现 .html PDP；价格/库存/评分汇总使用 PDP 的 meta/class；TCL 样本没有评价条目。",
  "anchor": "h1",

  "search": {
    "container": "a[href$='.html']",
    "sku": { "self_attr": "href" },
    "title": {
      "selectors": ["[itemprop='name']", "h3", "h2"],
      "transform": "clean_text"
    },
    "url": { "self_attr": "href" }
  },

  "product": {
    "title": { "selectors": ["h1"], "transform": "clean_text" },
    "brand": {
      "selectors": ["meta[itemprop='brand']"],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "selectors": ["h1"],
      "transform": "palacio_model"
    },
    "size": {
      "selectors": ["h1"],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": ["meta[itemprop='sku']"],
      "attr": "content",
      "transform": "clean_text"
    }
  },

  "price": {
    "price": {
      "selectors": ["meta[itemprop='lowPrice']"],
      "attr": "content",
      "transform": "money"
    },
    "currency": {
      "selectors": ["meta[itemprop='priceCurrency']"],
      "attr": "content",
      "transform": "currency_mx"
    },
    "list_price": {
      "selectors": ["meta[itemprop='highPrice']"],
      "attr": "content",
      "transform": "money"
    },
    "in_stock": {
      "selectors": ["meta[itemprop='availability']"],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "selectors": [".b-product_price-sales", ".b-product_price-old"],
      "transform": "clean_text"
    }
  },

  "specs": [],

  "summary": {
    "avg_rating": {
      "selectors": ["[itemprop='ratingValue']"],
      "transform": "rating"
    },
    "total_count": {
      "selectors": ["meta[itemprop='reviewCount']"],
      "attr": "content",
      "transform": "int"
    }
  },

  "reviews": {
    "container": "[itemprop='review'], [data-testid*='review'], .pr-review, article[class*='review']",
    "limit": 40,
    "fields": {
      "review_key": { "self_attr": "id" },
      "rating": { "selectors": ["[data-testid*='rating']", ".pr-rating-stars", "[itemprop='ratingValue']"], "transform": "rating" },
      "title": { "selectors": ["[data-testid*='review-title']", ".pr-rd-review-headline", "[itemprop='name']"], "transform": "clean_text" },
      "body": { "selectors": ["[data-testid*='review-text']", ".pr-rd-description-text", "[itemprop='reviewBody']"], "transform": "clean_text" },
      "author": { "selectors": ["[data-testid*='author']", ".pr-rd-author-nickname", "[itemprop='author']"], "transform": "clean_text" },
      "review_date": { "selectors": ["[data-testid*='date']", ".pr-rd-review-date", "[itemprop='datePublished']"], "transform": "clean_text" },
      "helpful_count": { "selectors": ["[data-testid*='helpful']", ".pr-helpful-count"], "transform": "int" },
      "review_url": { "selectors": [] }
    },
    "media": {
      "images": { "selector": "[itemprop='review'] img, [data-testid*='review'] img, .pr-review img", "attr": "src", "exclude": ["avatar", "icon"], "limit": 30 },
      "videos": { "selector": "[itemprop='review'] video source, [data-testid*='review'] video source, .pr-review video source", "attr": "src", "limit": 10 }
    }
  }
}
