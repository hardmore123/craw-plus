{
  "retail_spec_version": "0.1",
  "code": "coral_ec",
  "name": "Coral",
  "country": "Ecuador",
  "channel": "Coral",
  "region": "ec",
  "base_url": "https://coralhipermercados.com",
  "currency": "USD",
  "capabilities": [
    "price"
  ],
  "status": "candidate",
  "anchor": "h1",
  "generated_by": "2026-09-25 复探确认: Magento 2 (Omnipro/Coral frontend)，原生评价模块启用但全站零评价（5/5 PDP empty + 分类页 rating 块全 0），reviews.source=none；空评价用 product-reviews-summary empty + 'sea el primero' 判定；listAjax 返 503(端点降级非404)；BlockDetector 对 PDP head 的 reCAPTCHA 脚本误报 marker:captcha，页面实为真实200",
  "_design": {
    "平台": "Magento 2 (Omnipro/Coral frontend, static version1790209354)",
    "dataLayer": "item_reviews_count / item_reviews_score",
    "empty_marker": "product-reviews-summary empty + 'sea el primero en dejar una reseña'",
    "listAjax": "/review/product/listAjax/id/<mage_id>/ 对所有 mage_id 返 503（Varnish/FPC 端点降级或服务端限流，非 404）",
    "category_card": "分类页 9 产品卡 rating-summary/rating-result/reseña 计数全 0 → 站点级无评价佐证",
    "no_widget": "无 BV/Yotpo/Trustpilot 挂件",
    "no_jsonld": "无 aggregateRating/reviewBody",
    "rate_limit": "该站 503 限流明显（全新浏览器/带 referer/长冷却均持续），逐页开浏览器并每页冷却15s；PDP 被 503 拦时改读分类页产品卡 rating 块计数（全 0）做站点级佐证，避免逐个强攻 503"
  },
  "search": {
    "container": "li.product-item, .product-item-link",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 6000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 40,
      "fallback_per_model": true
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        ".page-title"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[itemprop='brand']",
        "meta[itemprop='brand']"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9._\\-]{1,39})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[itemprop='sku']",
        "meta[itemprop='sku']"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        ".price",
        "[data-price-amount]"
      ],
      "attr": "content",
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']",
        "meta[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "default": "USD"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        ".old-price",
        "[data-price-amount]"
      ],
      "attr": "content",
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[itemprop='availability']",
        ".stock"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "none",
    "_note": "Magento 2 原生评价站，2026-09-25 复探确认零评价（5/5 PDP 均 product-reviews-summary empty + 'Sea el primero en dejar una reseña'，分类页 9 卡 rating-summary/rating-result 全 0）。source=none（模块启用但全站无用户评价，与 hiraoka_pe/laganga_ec/panafoto_pa 同型）。空评价判据：product-reviews-summary empty + 'sea el primero en dejar una reseña'；listAjax 返 503（Varnish 端点降级，非 404 模块未启用）不能误判为有评论被拦。★BlockDetector 误报：PDP head 含 Google reCAPTCHA 脚本引用触发 marker:captcha，页面实为 200 真实页（h1+评价区齐全），需按 captcha 豁免。★503 限流：逐页开+每页冷却15s，重试2次；PDP 被 503 拦时改读分类页产品卡 rating 块计数（全 0）做站点级佐证",
    "detect": [
      "product-reviews-summary empty → 零评价",
      "sea el primero en dejar una reseña → 零评价佐证",
      "listAjax XHR body 解析 review-item（本站均 503/空）"
    ],
    "rate_limit": "503 限流：逐页开+每页冷却15s，重试2次",
    "fallback": "PDP 被 503 拦时改读分类页产品卡 rating 块计数（全 0）做站点级佐证",
    "container": ".product-reviews-summary, .review-item, [itemprop='review']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']"
        ],
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "summary": {
    "_note": "dataLayer item_reviews_count/item_reviews_score 自报 0",
    "avg_rating": {
      "selectors": [
        ".rating-summary .rating-result",
        "[itemprop='ratingValue']"
      ],
      "attr": "title",
      "transform": "rating"
    },
    "total_count": {
      "selectors": [
        ".product-reviews-summary .count",
        "[itemprop='reviewCount']"
      ],
      "transform": "int"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3,
      "core_strip_suffix": [
        "pro",
        "max"
      ]
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto",
        "remote",
        "bracket",
        "case",
        "cover",
        "soundbar",
        "barra de sonido",
        "parlante",
        "bocina",
        "proyector",
        "projector",
        "rack",
        "antena",
        "cleaner",
        "limpiador",
        "protector",
        "pantalla"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none",
      "_note": "listAjax 端点 503 降级，不可直连"
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": true,
    "interval_sec": 15.0,
    "retail_page_wait": "h1",
    "_note": "★503 限流明显，每页冷却15s + 重试2次",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.8,
    "price_fill_rate_min": 0.9,
    "reviews": "native empty (product-reviews-summary empty + 'sea el primero'), leave empty"
  }
}
