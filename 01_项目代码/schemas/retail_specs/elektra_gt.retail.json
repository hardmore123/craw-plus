{
  "retail_spec_version": "0.1",
  "code": "elektra_gt",
  "name": "Elektra",
  "country": "Guatemala",
  "channel": "Elektra",
  "region": "gt",
  "base_url": "https://www.elektra.com.gt",
  "currency": "GTQ",
  "capabilities": [
    "price",
    "reviews"
  ],
  "status": "candidate",
  "generated_by": "2026-09-24 实测: VTEX (ektguatemala) + Yotpo 评价后端",
  "anchor": "h1",
  "search": {
    "container": "a[href*='/p']",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "selectors": [
        "[class*='product-name']",
        "h3",
        "h2"
      ],
      "transform": "clean_text"
    },
    "url": {
      "self_attr": "href"
    },
    "batch": {
      "max_candidates": 60,
      "keyword_template": "{brand} televisor"
    },
    "api": {
      "type": "vtex_catalog",
      "_note": "detect_search_api.py 2026-10-08 实测接口可用；搜索候选走 VTEX Catalog API，详情页仍按 product/price 段抽取"
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[class*='brand']"
      ],
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9-]{4,20})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "jsonld": "sku",
      "transform": "clean_text"
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "[class*='price']",
        "[data-testid*='price']"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "transform": "currency",
      "default": "GTQ"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[class*='buy-button']:not([disabled])"
      ],
      "transform": "in_stock"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        "[class*='list-price']",
        "[class*='old-price']",
        "[class*='was-price']",
        "[class*='original-price']",
        "[class*='strike']",
        "s",
        "del"
      ],
      "transform": "money"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "selectors": [
        "[class*='price']",
        "[itemprop='price']",
        "[data-price]"
      ],
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "yotpo",
    "yotpo": {
      "app_key": "Yx5PqPQGSeQzSjdlNcyjpBRu1TmbaWWvbGqKmpbp",
      "api_endpoint": "https://api-cdn.yotpo.com/v1/widget/{app_key}/products/{sku}/reviews.json?per_page=150&page={page}",
      "_note": "纯 HTTP 直连无需浏览器/cookie/Origin; product_id=DB product.sku",
      "page_size": 150,
      "max_pages": 20,
      "max_reviews": 1000
    },
    "container": ".yotpo-review, [class*='yotpo']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[class*='yotpo-rating']",
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[class*='review-body']",
          "[itemprop='reviewBody']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[class*='yotpo-user']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[class*='yotpo-date']"
        ],
        "transform": "clean_text"
      },
      "verified": {
        "selectors": [
          "[class*='verified-buyer']"
        ],
        "transform": "bool_present"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title",
        "sku"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "core_strip_suffix": [
        "pro",
        "max"
      ],
      "min_core_len": 3
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "control remoto",
        "bocina",
        "parlante"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none"
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": true,
    "interval_sec": 6.0,
    "retail_page_wait": "h1",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.9
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "selectors": [
        "[itemprop='ratingValue']",
        "[class*='rating-value']",
        "[class*='avg-rating']"
      ],
      "attr": "content",
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "selectors": [
        "[itemprop='reviewCount']",
        "[class*='review-count']",
        "[class*='total-review']"
      ],
      "attr": "content",
      "transform": "int"
    }
  }
}
