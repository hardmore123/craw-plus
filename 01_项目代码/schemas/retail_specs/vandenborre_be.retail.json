{
  "retail_spec_version": "0.1",
  "code": "vandenborre_be",
  "name": "Vanden Borre",
  "country": "Belgium",
  "channel": "Vanden Borre",
  "region": "be",
  "base_url": "https://www.vandenborre.be",
  "currency": "EUR",
  "capabilities": [
    "price",
    "reviews"
  ],
  "generated_by": "benelux_nordic_probe/2026-09-25",
  "status": "candidate",
  "anchor": "h1, script[type='application/ld+json']",
  "shops": {
    "mode": "single_shop"
  },
  "search": {
    "container": "[class*='product'], a[href*='/product/']",
    "wait_ms": 5000,
    "scroll_passes": 3,
    "batch": {
      "max_candidates": 60,
      "max_pages": 20,
      "threshold": 10
    }
  },
  "price": {
    "selectors": [
      "[class*='price']",
      "[data-testid*='price']",
      ".price",
      ".product-price"
    ],
    "transform": "money",
    "jsonld": true,
    "price": {
      "selectors": [
        "[class*='price']",
        "[data-testid*='price']",
        ".price",
        ".product-price"
      ],
      "transform": "money",
      "jsonld": "offers.price"
    },
    "currency": {
      "selectors": [
        "[itemprop='priceCurrency']",
        "meta[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "jsonld": "offers.priceCurrency",
      "default": "EUR"
    },
    "list_price": {
      "selectors": [
        "[class*='old-price']",
        "[class*='original-price']",
        "s",
        "del"
      ],
      "transform": "money"
    },
    "raw_text": {
      "selectors": [
        "[class*='price']"
      ],
      "transform": "clean_text"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "on_no_match": "skip",
    "verify": {
      "require_model_in": [
        "title",
        "url",
        "sku"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "min_core_len": 3
    },
    "reject": {
      "title_contains_any": [
        "case",
        "cover",
        "wall mount",
        "stand",
        "bracket",
        "protector",
        "cable",
        "adapter",
        "remote",
        "control",
        "mount",
        "screw",
        "charger",
        "soundbar",
        "speaker"
      ]
    }
  },
  "reviews": {
    "source": "jsonld",
    "container": "[itemprop='review'], [class*='review'], [data-testid*='review']",
    "limit": 40,
    "jsonld": {
      "product_type": "Product",
      "aggregateRating": "aggregateRating",
      "review_array": "review",
      "field_map": {
        "review_key": "datePublished|author.name",
        "rating": "reviewRating.ratingValue",
        "title": "name",
        "body": "description",
        "author": "author.name",
        "review_date": "datePublished"
      }
    },
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[itemprop='name']",
          "[class*='review-title']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']"
        ],
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "selectors": [
        "[itemprop='ratingValue']"
      ],
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "selectors": [
        "[itemprop='reviewCount']"
      ],
      "transform": "int"
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        "#productTitle",
        "[itemprop='name']"
      ],
      "transform": "clean_text",
      "jsonld": "name"
    },
    "brand": {
      "selectors": [
        "[itemprop='brand']",
        "[data-brand]",
        "[class*='brand']",
        "[itemprop='manufacturer']"
      ],
      "attr": "content",
      "transform": "brand",
      "jsonld": "brand.name"
    },
    "model": {
      "selectors": [
        "[itemprop='model']",
        "[itemprop='mpn']",
        "[data-testid*='model']",
        "[data-model]"
      ],
      "attr": "content",
      "jsonld": "mpn",
      "regex": "\\b([A-Z0-9][A-Z0-9._-]{3,25})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "regex": "(\\d{2,3})\\s*(?:\"|inch|in|pulgada|Zoll|pollici|pouces|インチ|型)",
      "transform": "size_inch"
    },
    "category": {
      "selectors": [
        "[itemprop='category']",
        ".breadcrumb li:last-child",
        ".breadcrumbs li:last-child"
      ],
      "transform": "clean_text"
    }
  }
}
