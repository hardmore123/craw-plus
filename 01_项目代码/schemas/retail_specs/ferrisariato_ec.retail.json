{
  "retail_spec_version": "0.1",
  "code": "ferrisariato_ec",
  "name": "Ferrisariato",
  "country": "Ecuador",
  "channel": "Ferrisariato",
  "region": "ec",
  "base_url": "https://www.ferrisariato.com",
  "currency": "USD",
  "capabilities": [
    "price"
  ],
  "status": "candidate",
  "anchor": "h1",
  "generated_by": "2026-09-24 实测: 双站架构——DB site=ferrisariato 但 product.url 全指向 www.frecuento.com 子站（自建电商，后端 app.frecuento.com）；无任何评价基础设施",
  "_design": {
    "平台": "自建电商（frecuento.com 子站，后端 app.frecuento.com）+ ferrisariato 主站 WordPress 落地页",
    "host_split": "DB site=ferrisariato_ec，但 product.url 全指向 www.frecuento.com 子站（Elrosado 集团电商）；主站 ferrisariato 仅 WordPress 落地/营销页",
    "api": "app.frecuento.com 自建 REST API: /products/{sku}/ 返回详情 JSON(amount_total/brand/description/photos/categories/stock)；/products/{sku}/related /recommend/* 相关推荐；无评价端点",
    "jsonld": "Product JSON-LD 有(offers.priceCurrency/availability/sku) 但无 aggregateRating(无评分聚合)",
    "review_backend": "无——PDP 无评价 DOM、JSON-LD 无 aggregateRating、app.frecuento.com 产品 API 无评价字段、所有 /reviews /comments /opinions 端点 404、无 BV/Yotpo/PowerReviews/Reviews.io/verificado.ai/Feefo/Trustpilot/JudgeMe/Stamped 挂件",
    "waf": "Incapsula(Imperva) 边缘防护 + reCAPTCHA；浏览器(stealth+human_like)可过，纯 HTTP 需浏览器 cookie；app.frecuento.com 跨域 fetch 被 CORS 拦截需用 pg.goto 或 ctx.request",
    "false_positive": "'comentar'/'review' 关键词易被 CookieYes 弹窗 CSS/文案误命中，必须看上下文 + eval DOM 计数 + JSON-LD aggregateRating 三重确认",
    "currency": "USD（厄瓜多尔美元化）"
  },
  "search": {
    "container": "a.product-item-link, .product-card",
    "_note": "主站 ferrisariato 是 WordPress 无产品页；实际抓 frecuento.com 子站",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 6000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 40,
      "fallback_per_model": true
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "jsonld": "brand",
      "selectors": [
        "[itemprop='brand']",
        ".brand-name"
      ],
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9._\\-]{1,39})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "jsonld": "sku",
      "selectors": [
        "[itemprop='sku']",
        "meta[itemprop='sku']"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        ".product-price",
        "[data-price]"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']",
        "meta[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "default": "USD"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        ".old-price",
        "[data-list-price]"
      ],
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[itemprop='availability']",
        ".stock"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "none",
    "_note": "★无评价基础设施：PDP 无评价 DOM、JSON-LD 无 aggregateRating、app.frecuento.com 产品 API 无评价字段、所有评价端点 404、无第三方评价挂件。按红线连 summary 都不写，只记 crawl_run 留痕",
    "container": "[class*='review'], [itemprop='review']",
    "limit": 0,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']"
        ],
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "transform": "int"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3,
      "core_strip_suffix": [
        "pro",
        "max"
      ]
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto",
        "remote",
        "bracket",
        "case",
        "cover",
        "soundbar",
        "barra de sonido",
        "parlante",
        "bocina",
        "proyector",
        "projector",
        "rack",
        "antena",
        "cleaner",
        "limpiador",
        "protector",
        "pantalla"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none"
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": true,
    "interval_sec": 6.0,
    "retail_page_wait": "h1",
    "_note": "Incapsula WAF 需浏览器过；app.frecuento.com API 跨域需 pg.goto/ctx.request",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.85,
    "price_fill_rate_min": 0.9,
    "reviews": "no infrastructure, leave empty"
  }
}
