{
  "retail_spec_version": "0.1",
  "code": "laganga_ec",
  "name": "L-Ganga",
  "country": "Ecuador",
  "channel": "L-Ganga",
  "region": "ec",
  "base_url": "https://laganga.com",
  "currency": "USD",
  "capabilities": [
    "price"
  ],
  "status": "candidate",
  "anchor": "h1",
  "generated_by": "2026-09-25 probe2 复核: 5产品 PDP 全部 hide__rating + dataLayer item_reviews_count=0 + DOM 评价区 count=0 + JSON-LD 无 aggregateRating/review + 无 BV/Yotpo/Trustpilot 挂件 + 非 VTEX → 确认全站禁用评价，reviews.source=none，capabilities 移除 reviews",
  "_design": {
    "平台": "Magento 2 (body class product-layout-1, data-mage-init)",
    "hide_rating": "body class 恒含 hide__rating → 前端全局禁用评分/评价 UI",
    "dataLayer": "dl4Objects.items[].item_reviews_count / item_reviews_score 自报 0",
    "no_summary": "无 .product-reviews-summary / 无 review tab / 无 #product-review-container",
    "no_widget": "无 BV / Yotpo / Trustpilot 挂件",
    "listAjax_404": "Magento 标准 review/product/listAjax/id/<pid>/ → 404（评价模块未启用）",
    "currency": "USD（厄瓜多尔美元化）"
  },
  "search": {
    "container": "li.product-item, .product-item-link",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 6000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 40,
      "fallback_per_model": true
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        ".page-title"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[itemprop='brand']",
        "meta[itemprop='brand']"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9._\\-]{1,39})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[itemprop='sku']",
        "meta[itemprop='sku']"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        ".price",
        "[data-price-amount]"
      ],
      "attr": "content",
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']",
        "meta[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "default": "USD"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        ".old-price",
        "[data-price-amount]"
      ],
      "attr": "content",
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[itemprop='availability']",
        ".stock"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "none",
    "_note": "★全站禁用评价：body class 含 hide__rating + dataLayer item_reviews_count=0 + listAjax 端点 404（评价模块未启用）→ 留空不造假，不写 review/review_summary。遇 Magento 2 站先查 body class hide__rating + dataLayer item_reviews_count，二者命中即确认全站禁用评价，无需逐页解析",
    "detect": [
      "body class 含 hide__rating 即全站禁用评价",
      "抓 dataLayer item_reviews_count：/\"item_reviews_count\":\"?(\\d+)/",
      "listAjax 端点 404 即确认评价模块未启用"
    ],
    "container": "[class*='review'], [itemprop='review']",
    "limit": 0,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']"
        ],
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "transform": "int"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3,
      "core_strip_suffix": [
        "pro",
        "max"
      ]
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto",
        "remote",
        "bracket",
        "case",
        "cover",
        "soundbar",
        "barra de sonido",
        "parlante",
        "bocina",
        "proyector",
        "projector",
        "rack",
        "antena",
        "cleaner",
        "limpiador",
        "protector",
        "pantalla"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none"
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": true,
    "interval_sec": 6.0,
    "retail_page_wait": "h1",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.85,
    "price_fill_rate_min": 0.9,
    "reviews": "disabled by theme (hide__rating), leave empty"
  }
}
