{
  "retail_spec_version": "0.1",
  "code": "ripley_pe",
  "name": "Ripley PE",
  "country": "Peru",
  "channel": "Ripley",
  "region": "pe",
  "base_url": "https://simple.ripley.com.pe",
  "currency": "PEN",
  "anchor": "h1, script[type='application/ld+json']",
  "shops": {
    "mode": "single_shop"
  },
  "_isomorphic": {
    "brand": "ripley",
    "reuse": "falabella_cl/falabella_co/ripley_cl（同平台 Falabella 集团同构，L2）"
  },
  "capabilities": [
    "price"
  ],
  "generated_by": "_gen_retail10.py 2026-09-26",
  "status": "blocked",
  "_blocked": {
    "http_status": -1,
    "block_reason": "http_-1：非 200",
    "note": "需住宅IP或代理切换；可达后补全 search/price/match 段"
  },
  "price": {
    "currency": "PEN",
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "[data-price]",
        ".price",
        "[class*='price']"
      ],
      "transform": "money"
    },
    "raw_text": {
      "selectors": [
        "[class*='price']",
        ".price"
      ],
      "jsonld": "offers.price",
      "transform": "clean_text"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        ".product-price--old",
        ".old-price",
        "[data-list-price]"
      ],
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[itemprop='availability']",
        ".stock"
      ],
      "attr": "content",
      "transform": "in_stock"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "verify": {
      "require_model_in": [
        "title"
      ]
    },
    "on_no_match": "skip"
  },
  "search": {
    "container": "a[href*='/producto/'], .product-card",
    "sku": {
      "self_attr": "href",
      "_note": "__NEXT_DATA__ sku/id/partNumber; 兜底从 url 末段取数字"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 5000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 40,
      "fallback_per_model": true
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        ".product-name",
        "[data-testid='product-title']"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[itemprop='brand']",
        "meta[itemprop='brand']",
        ".brand-name"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9._\\-]{1,39})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[itemprop='sku']",
        "meta[itemprop='sku']",
        "[data-sku]"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "selectors": [
        "[itemprop='ratingValue']"
      ],
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "selectors": [
        "[itemprop='reviewCount']"
      ],
      "transform": "int"
    }
  },
  "reviews": {
    "source": "unknown_blocked",
    "container": "[class*='review'], [itemprop='review']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']"
        ],
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  }
}
