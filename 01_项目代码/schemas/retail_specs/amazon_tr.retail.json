{
  "retail_spec_version": "0.1",
  "code": "amazon_tr",
  "name": "Amazon TR",
  "country": "Turkey",
  "channel": "Amazon",
  "region": "tr",
  "base_url": "https://www.amazon.com.tr",
  "currency": "TRY",
  "capabilities": [
    "price"
  ],
  "generated_by": "turkey_russia_ukraine_probe/2026-09-25",
  "status": "candidate",
  "anchor": "h1, script[type='application/ld+json']",
  "shops": {
    "mode": "single_shop"
  },
  "_isomorphic": {
    "brand": "amazon",
    "reuse": "amazon_common（Amazon 各国前端同构：div[data-asin] 候选 + data-hook 价格/评论）"
  },
  "search": {
    "container": "[class*='product'], a[href*='/product/'], a[href*='/pd/']",
    "wait_ms": 5000,
    "scroll_passes": 3,
    "batch": {
      "max_candidates": 60,
      "max_pages": 20,
      "threshold": 10,
      "prefer_pool": true,
      "search_pages": 1,
      "fallback_per_model": true,
      "retries": 1
    },
    "sku": {
      "self_attr": "data-asin"
    },
    "title": {
      "selectors": [
        "h2 span:not([class])",
        "a[class*='s-line-clamp']",
        "span.a-size-medium",
        "h2 span",
        "[data-cy='title-recipe'] span"
      ],
      "transform": "clean_text"
    },
    "url_template": "https://www.amazon.com.tr/dp/{sku}"
  },
  "price": {
    "selectors": [
      "[class*='price']",
      "[data-testid*='price']",
      ".price",
      ".product-price"
    ],
    "transform": "money",
    "jsonld": false,
    "price": {
      "selectors": [
        "#corePrice_feature_div span.a-price span.a-offscreen",
        "#corePriceDisplay_desktop_feature_div span.a-price span.a-offscreen",
        "#apex_desktop .a-price .a-offscreen",
        "#corePrice_feature_div .a-offscreen",
        "#corePriceDisplay_desktop_feature_div .a-offscreen",
        "#priceblock_ourprice",
        "#priceblock_dealprice",
        "#priceblock_saleprice"
      ],
      "transform": "money"
    },
    "currency": {
      "selectors": [
        "#corePrice_feature_div span.a-price span.a-offscreen",
        "#corePriceDisplay_desktop_feature_div span.a-price span.a-offscreen",
        "#apex_desktop .a-price .a-offscreen",
        "#corePrice_feature_div .a-offscreen",
        "#corePriceDisplay_desktop_feature_div .a-offscreen",
        "#priceblock_ourprice",
        "#priceblock_dealprice",
        "#priceblock_saleprice"
      ],
      "transform": "currency",
      "default": "TRY"
    },
    "list_price": {
      "selectors": [
        "span.a-price.a-text-price span.a-offscreen",
        "#listPrice",
        "#priceblock_listprice"
      ],
      "transform": "money"
    },
    "in_stock": {
      "selectors": [
        "#availability span",
        "#availability",
        "#add-to-cart-button"
      ],
      "transform": "in_stock"
    },
    "raw_text": {
      "selectors": [
        "#corePrice_feature_div span.a-price span.a-offscreen",
        "#corePriceDisplay_desktop_feature_div span.a-price span.a-offscreen",
        "#priceblock_ourprice"
      ],
      "transform": "clean_text"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "verify": {
      "require_model_in": [
        "title"
      ]
    },
    "on_no_match": "skip"
  },
  "product": {
    "title": {
      "selectors": [
        "#productTitle",
        "#title span"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "#bylineInfo",
        "a#bylineInfo",
        "#brand",
        "#detailBullets_feature_div li:has-text('Marka')",
        "#detailBullets_feature_div li:has-text('Brand')"
      ],
      "transform": "brand"
    },
    "model": {
      "_note": "amazon.com.tr 的 detailBullets 实测保留英文 'Item model number' 标签（与 amazon.se 同构），同时兼容土耳其语 'Model numarası'。",
      "kv": {
        "container": "#detailBullets_feature_div li, #productDetails_techSpec_section_1 tr, #productDetails_detailBullets_sections1 tr, #productDetails_techSpec_section_2 tr, #detailBulletsWrapper_feature_div li, #productDetailsBulletsWrapper_feature_div li",
        "key_contains": "model",
        "value": "td"
      },
      "selectors": [
        "#productDetails_techSpec_section_1 tr:has-text('Item model number') td",
        "#detailBullets_feature_div li:has-text('Item model number')"
      ],
      "transform": "clean_text"
    },
    "category": {
      "selectors": [
        "#wayfinding-breadcrumbs_feature_div ul li:last-child a",
        "#nav-subnav a.nav-b"
      ],
      "transform": "clean_text"
    },
    "size": {
      "_note": "尺寸：优先变体选择项，其次规格表里的 Screen size / Ekran boyutu。",
      "kv": {
        "container": "#productDetails_techSpec_section_1 tr, #detailBullets_feature_div li",
        "key_contains": "screen size",
        "value": "td"
      },
      "selectors": [
        "#inline-twister-expanded-dimension-text-size_name",
        "#variation_size_name .selection"
      ],
      "transform": "size_inch"
    }
  },
  "specs": [
    {
      "type": "table",
      "container": "#productDetails_techSpec_section_1 tr, #productDetails_techSpec_section_2 tr, #productDetails_detailBullets_sections1 tr",
      "key": "th",
      "value": "td",
      "limit": 120
    },
    {
      "type": "kvlist",
      "container": "#detailBullets_feature_div li",
      "limit": 120,
      "skip_keys": [
        "customer reviews",
        "best sellers rank",
        "date first available",
        "müşteri yorumları",
        "en çok satanlar sıralaması"
      ]
    }
  ],
  "summary": {
    "avg_rating": {
      "selectors": [
        "#acrPopover",
        "span[data-hook='rating-out-of-text']",
        "#averageCustomerReviews .a-icon-alt"
      ],
      "attr": "title",
      "transform": "rating"
    },
    "total_count": {
      "selectors": [
        "#acrCustomerReviewText",
        "[data-hook='total-review-count']"
      ],
      "transform": "int"
    }
  },
  "reviews": {
    "container": "[data-hook='review'], div[id][data-hook='review']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[data-hook='review-star-rating'] .a-icon-alt",
          "[data-hook='cmps-review-star-rating'] .a-icon-alt",
          "i[data-hook='review-star-rating']"
        ],
        "transform": "rating"
      },
      "title": {
        "_note": "2026-09 实测：新模板用驼峰 reviewTitle，旧模板用 review-title，两者都留。",
        "selectors": [
          "[data-hook='reviewTitle']",
          "[data-hook='review-title'] span:not([class])",
          "[data-hook='review-title'] span",
          "[data-hook='review-title']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[data-hook='reviewText'] span",
          "[data-hook='reviewText']",
          "[data-hook='reviewTextContainer'] span",
          "[data-hook='review-body'] span",
          "[data-hook='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          ".a-profile-name"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[data-hook='review-date']"
        ],
        "transform": "clean_text"
      },
      "verified": {
        "selectors": [
          "[data-hook='avp-badge']"
        ],
        "transform": "bool_present"
      },
      "helpful_count": {
        "selectors": [
          "[data-hook='helpful-vote-statement']"
        ],
        "transform": "int"
      },
      "review_url": {
        "_note": "新模板 reviewTitle 是 <a><h5 data-hook=reviewTitle>，链接在外层 a；老模板 a[data-hook=review-title]。",
        "selectors": [
          "a:has(h5[data-hook='reviewTitle'])",
          "a[data-hook='review-title']",
          "h5[data-hook='reviewTitle'] a",
          "a.a-link-normal.review-title-content"
        ],
        "attr": "href"
      }
    },
    "media": {
      "_note": "图片实测选择器 img[data-hook='review-image-tile']，真实图 URL 含 /images/I/，头像 avatars-global 要排除；缩略图 _SY88_ 换 _SL1600_ 拿高清。",
      "images": {
        "selector": "img[data-hook='review-image-tile'], .review-image-tile img, [data-hook='review-image-tile-section'] img",
        "attr": "src",
        "include": [
          "media-amazon.com/images/I/"
        ],
        "exclude": [
          "avatars-global",
          "grey-pixel"
        ],
        "hires": [
          "\\._[A-Z]{2}[0-9]+_",
          "._SL1600_"
        ],
        "limit": 30
      },
      "videos": {
        "selector": "video[data-hook='review-video'] source, [data-hook='review-video'] video, video.review-video source",
        "attr": "src",
        "exclude": [],
        "limit": 10
      }
    }
  }
}
