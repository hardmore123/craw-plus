{
  "retail_spec_version": "0.1",
  "code": "hisense_bo",
  "name": "Hisense（玻利维亚）",
  "country": "Bolivia",
  "channel": "Hisense 官网",
  "region": "bo",
  "base_url": "https://hisense.com.bo",
  "currency": "BOB",
  "capabilities": [
    "price"
  ],
  "generated_by": "SA4 任务实测生成 (2026-09-27)：BrowserFetcher(human_like=True) 200 OK；WordPress+Bricks 站；子分类页 /product-category/tv/<qled|miniled|canvas>/ 列产品 (https://hisense.com.bo/product/tv/qled/tv-85q6n-google-tv-qled-smart/)；★品牌展示型站 PDP 无在线价格 (无 woocommerce-Price/data-price/Bs/$)，price 选择器配齐抓不到即留空（缺价>错价）",
  "status": "candidate",
  "anchor": "h1, .product, article",
  "search": {
    "container": "a[href*='/product/tv/'], a[href*='hisense.com.bo/product/']",
    "sku": {
      "selectors": [
        "a[href*='/product/tv/']"
      ],
      "attr": "href"
    },
    "title": {
      "selectors": [
        "h2.brxe-heading",
        "h3",
        "h2",
        "img"
      ],
      "attr": "alt",
      "transform": "clean_text"
    },
    "url": {
      "selectors": [
        "a[href*='/product/tv/']"
      ],
      "attr": "href"
    },
    "wait_ms": 5000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 60,
      "fallback_per_model": true
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        "h1.product_title",
        ".product-title"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "meta[itemprop='brand']",
        "[data-brand]"
      ],
      "attr": "content",
      "transform": "brand",
      "jsonld": "brand.name"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9._\\-]{1,39})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1",
        "h1.product_title"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "meta[itemprop='sku']",
        "[data-product_id]"
      ],
      "attr": "content",
      "transform": "clean_text",
      "jsonld": "sku"
    }
  },
  "price": {
    "price": {
      "selectors": [
        ".woocommerce-Price-amount",
        "[data-price-amount]",
        ".price",
        ".product-price"
      ],
      "transform": "money",
      "jsonld": "offers.price"
    },
    "currency": {
      "selectors": [
        "meta[itemprop='priceCurrency']",
        "[data-currency]"
      ],
      "attr": "content",
      "transform": "currency",
      "jsonld": "offers.priceCurrency",
      "default": "BOB"
    },
    "list_price": {
      "selectors": [
        ".woocommerce-Price-amount del",
        "del .woocommerce-Price-amount",
        "s .price"
      ],
      "transform": "money",
      "jsonld": "offers.highPrice"
    },
    "in_stock": {
      "selectors": [
        ".stock",
        "[itemprop='availability']",
        ".in-stock"
      ],
      "attr": "content",
      "transform": "in_stock",
      "jsonld": "offers.availability"
    },
    "raw_text": {
      "selectors": [
        ".price",
        ".woocommerce-Price-amount"
      ],
      "transform": "clean_text"
    }
  },
  "specs": [],
  "summary": {
    "avg_rating": {
      "selectors": [
        ".star-rating",
        "[itemprop='ratingValue']"
      ],
      "transform": "rating",
      "jsonld": "aggregateRating.ratingValue"
    },
    "total_count": {
      "selectors": [
        ".review-count",
        "[itemprop='reviewCount']"
      ],
      "transform": "int",
      "jsonld": "aggregateRating.reviewCount"
    }
  },
  "reviews": {
    "container": ".comment, .review, [itemprop='review'], #comments li",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          ".star-rating",
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          ".comment-title",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          ".comment-text",
          "[itemprop='reviewBody']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          ".comment-author",
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          ".comment-date",
          "time",
          "[itemprop='datePublished']"
        ],
        "transform": "clean_date"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "core_strip_suffix": [
        "pro",
        "max"
      ],
      "min_core_len": 3
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto",
        "remote",
        "bracket",
        "case",
        "cover",
        "soundbar",
        "barra de sonido",
        "parlante",
        "bocina",
        "proyector",
        "rack",
        "antena"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none"
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": true,
    "interval_sec": 6.0,
    "retail_page_wait": "h1, .product",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.5
  }
}
