{
  "retail_spec_version": "0.1",
  "code": "dismac_bo",
  "name": "Dismac",
  "country": "Bolivia",
  "channel": "Dismac",
  "region": "bo",
  "base_url": "https://www.dismac.com.bo",
  "currency": "BOB",
  "capabilities": [
    "price",
    "reviews"
  ],
  "status": "candidate",
  "anchor": "h1",
  "generated_by": "2026-09-24 实测: Magento 2 非标准站（div.product-item-pdc），评价由 Mageplaza_BetterProductReviews 扩展承载，POST /mpbetterproductreviews/product/ajaxsort/ 直连拿 review_list HTML",
  "_design": {
    "平台": "Magento 2（玻利维亚，非标准：div.product-item-pdc 而非 li.product-item）",
    "search_dom": "字段全在 meta[itemprop] 里(name/url/sku)；无 data-price-amount，用 span.current-price / .before-price",
    "currency_format": "BOB，格式 Bs. N,NNN.NN（逗号千分位、点小数）",
    "评价": "Mageplaza_BetterProductReviews 扩展（非 BV/VTEX/第三方）。PDP 评价区是 modal(animatedModalReviewList('open')) 静态 HTML 空壳，明细靠 POST /mpbetterproductreviews/product/ajaxsort/ 拿 review_list HTML（纯 HTTP，product_id 用 PDP data-product-id 即 Magento entity_id 非 DB sku）",
    "jsonld_agg": "PDP JSON-LD Product 有 aggregateRating（ratingValue 百分制 0-100 需 /20 转5星 + ratingCount，无 review 数组）；无评价产品无 aggregateRating 节点",
    "field_map": "review_key=review-item-XXXX；rating=.rating-result title%/20（百分制转5星）；title=.mp-review-title strong；body=.mp-review-content；author=.mp-review-author .mp-review-details-value；review_date=.mp-review-date time[datetime]",
    "sku_in_title": "否；型号在 SKU 里(K-55XR50/55NU800BPSB)，标题只有品牌+尺寸+系列"
  },
  "search": {
    "container": "div.product-item-pdc, .product-item-link",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 6000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 40,
      "fallback_per_model": true,
      "_note": "搜索相关性差：q=televisor 返回20条含2条非电视(支架/遥控)，按标题以 Televisor 开头过滤"
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        ".page-title"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[itemprop='brand']",
        "meta[itemprop='brand']"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9._\\-]{1,39})\\b",
      "transform": "clean_text",
      "_note": "型号在 SKU 里（去 K- 前缀），标题无型号"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[itemprop='sku']",
        "meta[itemprop='sku']",
        "[data-product-id]"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "span.current-price",
        ".price"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']",
        "meta[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "default": "BOB"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        "span.before-price",
        ".old-price"
      ],
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[itemprop='availability']",
        ".stock"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "mageplaza_ajaxsort_http",
    "_note": "POST /mpbetterproductreviews/product/ajaxsort/ (sort_type=1&product_id=<Magento entity_id>) 返 {success, review_list:HTML}；纯 HTTP 无需浏览器/登录。entity_id 从 PDP data-product-id 取（非 DB sku）。解析 review-item HTML：.mp-review-title strong=标题、.mp-review-content=正文、.rating-result title=百分制/20=星级",
    "container": ".mp-review-item, .review-item",
    "limit": 40,
    "fields": {
      "review_key": {
        "selectors": [
          "[id^='review-item-']"
        ],
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          ".rating-result"
        ],
        "attr": "title",
        "transform": "rating",
        "_note": "title='NN%' 百分制，/20 转5星"
      },
      "title": {
        "selectors": [
          ".mp-review-title strong"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          ".mp-review-content"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          ".mp-review-author .mp-review-details-value"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          ".mp-review-date time"
        ],
        "attr": "datetime",
        "transform": "clean_text"
      },
      "helpful_count": {
        "selectors": [
          ".mp-review-helpful-value"
        ],
        "transform": "int"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "transform": "rating",
      "_note": "百分制 0-100，需 /20 转5星"
    },
    "total_count": {
      "jsonld": "aggregateRating.ratingCount",
      "transform": "int"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "sku",
        "title"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3,
      "core_strip_suffix": [
        "pro",
        "max"
      ]
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto",
        "remote",
        "bracket",
        "case",
        "cover",
        "soundbar",
        "barra de sonido",
        "parlante",
        "bocina",
        "proyector",
        "projector",
        "rack",
        "antena",
        "cleaner",
        "limpiador",
        "protector",
        "pantalla"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none",
      "_note": "本站评论稀少(全站仅2条)，单请求即全量；超10条未测翻页"
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": false,
    "detail_http": true,
    "interval_sec": 6.0,
    "retail_page_wait": "h1",
    "_note": "评价 AJAX 纯 HTTP 直连，无需 BrowserFetcher；仅探测 modal 时用浏览器确认结构",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.9
  }
}
