{
  "retail_spec_version": "0.1",
  "code": "sukasa_ec",
  "name": "Sukasa",
  "country": "Ecuador",
  "channel": "Sukasa",
  "region": "ec",
  "base_url": "https://www.sukasa.com",
  "currency": "USD",
  "capabilities": [
    "price"
  ],
  "status": "candidate",
  "anchor": "h1",
  "generated_by": "2026-09-24 实测: Next.js(comohogar 自建,后端 api.comohogar.com,与 todohogar_ec 同平台同后端)，站点配置 seeComments=false 显式不公开评价",
  "_design": {
    "平台": "Next.js(comohogar 自建,后端 api.comohogar.com,与 todohogar_ec 同平台同后端)",
    "url_format_trap": "DB product.url 用旧格式 /producto/<slug>(单数,无 UUID)全 404；真实 PDP 路径 /productos/<slug>/<uuid>(复数+UUID)，slug+uuid 须从分类页/elastic-api 抓",
    "review_backend": "无——站点配置 seeComments=false 显式不公开评价（enableReview=true 允许提交但 seeComments=false 禁止查看）",
    "site_config": "general-api/config/list_config/{formatId=6e92987b-0a98-11ec-a8ee-0e18b4f7d03b} 的 data.config: seeComments=false + enableReview=true",
    "qualification_field": "__NEXT_DATA__.pageProps.product.qualification 字段存在但 3 个 TV 实测全为 null",
    "vtex_graphql": "/_v/public/graphql/v1 -> 404(非 VTEX 站)",
    "review_api_probe": "catalog-api/products/qualification|reviews|opinions/{id} 全 404 Whitelabel Error；review-api/reviews/{id} 404",
    "currency": "USD（厄瓜多尔美元化）"
  },
  "search": {
    "container": "a[href*='/productos/'], .product-card",
    "_note": "真实 PDP 是 /productos/<slug>/<uuid>（需从分类页 elastic-api 抓 UUID）",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 6000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 40,
      "fallback_per_model": true
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[data-testid='brand']",
        ".brand-name"
      ],
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9._\\-]{1,39})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[data-testid='sku']",
        "[itemprop='sku']"
      ],
      "attr": "content",
      "transform": "clean_text",
      "_note": "DB product.url 用旧 /producto/<slug> 全 404"
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        ".product-price",
        "[data-price]"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "default": "USD"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        ".old-price",
        "[data-list-price]"
      ],
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[itemprop='availability']",
        ".stock"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "none",
    "_note": "★站点级 seeComments=false 显式禁止展示评价（enableReview=true 允许提交但 seeComments=false 不展示）。探测评价来源时不能只看 PDP DOM/API，必须先查站点配置 general-api/config/list_config 的 data.config.seeComments——它直接判定全站不公开评价，省去逐产品探测。写 review_summary(total_count=0) 记录已探测状态，review 明细表留空不造假",
    "container": "[class*='review'], [itemprop='review']",
    "limit": 0,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']"
        ],
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "transform": "int",
      "_note": "seeComments=false → total=0"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3,
      "core_strip_suffix": [
        "pro",
        "max"
      ]
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto",
        "remote",
        "bracket",
        "case",
        "cover",
        "soundbar",
        "barra de sonido",
        "parlante",
        "bocina",
        "proyector",
        "projector",
        "rack",
        "antena",
        "cleaner",
        "limpiador",
        "protector",
        "pantalla"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none"
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": true,
    "interval_sec": 6.0,
    "retail_page_wait": "h1",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.85,
    "price_fill_rate_min": 0.9,
    "reviews": "site-level seeComments=false, leave empty"
  }
}
