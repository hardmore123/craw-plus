{
  "retail_spec_version": "0.1",
  "code": "tottus_pe",
  "name": "Tottus PE",
  "country": "Peru",
  "channel": "Tottus",
  "region": "pe",
  "base_url": "https://www.tottus.com.pe",
  "currency": "PEN",
  "anchor": "h1, script[type='application/ld+json']",
  "shops": {
    "mode": "single_shop"
  },
  "_isomorphic": {
    "brand": "tottus",
    "reuse": "falabella 集团系（tottus 为智利 Falabella 旗下商超，搜索结构与 falabella 类似）"
  },
  "capabilities": [
    "price"
  ],
  "generated_by": "_gen_retail10.py 2026-09-26",
  "status": "blocked",
  "_blocked": {
    "http_status": -1,
    "block_reason": "http_-1：非 200",
    "note": "需住宅IP或代理切换；可达后补全 search/price/match 段"
  },
  "price": {
    "currency": "PEN",
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "[data-price]",
        ".price",
        "[class*='price']"
      ],
      "transform": "money"
    },
    "raw_text": {
      "selectors": [
        "[class*='price']",
        ".price"
      ],
      "transform": "clean_text"
    },
    "list_price": {
      "selectors": [
        "[class*='list-price']",
        "s",
        "del",
        "[class*='old-price']"
      ],
      "transform": "money",
      "jsonld": "offers.highPrice"
    },
    "in_stock": {
      "selectors": [
        "[itemprop='availability']",
        "button[class*='add-to-cart']:not([disabled])"
      ],
      "attr": "content",
      "transform": "in_stock",
      "jsonld": "offers.availability"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "verify": {
      "require_model_in": [
        "title"
      ]
    },
    "on_no_match": "skip"
  },
  "search": {
    "container": "a[href*='/p'], a[href*='/pdp/']",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true,
      "transform": "clean_text"
    },
    "url": {
      "self_attr": "href"
    },
    "batch": {
      "max_candidates": 60
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        "[class*='product-name']",
        "[data-testid*='name']"
      ],
      "transform": "clean_text",
      "jsonld": "name"
    },
    "brand": {
      "selectors": [
        "[class*='brand']",
        "meta[itemprop='brand']"
      ],
      "attr": "content",
      "transform": "brand",
      "jsonld": "brand.name"
    },
    "model": {
      "kv": {
        "container": "table tr, .product-specification tr, [class*='specification'] tr",
        "key_contains": "modelo",
        "value": "td:nth-child(2)"
      },
      "transform": "clean_text",
      "jsonld": "mpn"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[itemprop='sku']",
        "meta[itemprop='sku']",
        "[data-sku]"
      ],
      "attr": "content",
      "transform": "clean_text",
      "jsonld": "sku"
    }
  },
  "summary": {
    "avg_rating": {
      "selectors": [
        "[itemprop='ratingValue']",
        "[class*='rating-value']",
        "[class*='average-rating']"
      ],
      "transform": "rating",
      "jsonld": "aggregateRating.ratingValue"
    },
    "total_count": {
      "selectors": [
        "[itemprop='reviewCount']",
        "[class*='review-count']",
        "[class*='total-review']"
      ],
      "transform": "int",
      "jsonld": "aggregateRating.reviewCount"
    }
  },
  "reviews": {
    "source": "bazaarvoice_bfd",
    "bv": {
      "client": "intercorp",
      "display_code": "27005_1_0",
      "site": "oechsle",
      "locale": "es_PE",
      "origin": "https://www.oechsle.pe",
      "content_locale": "es_PE",
      "page_size": 100,
      "max_pages": 20,
      "max_reviews": 1000
    },
    "container": "[class*='review'], [data-testid*='review'], [itemprop='review']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']",
          "[class*='rating']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']",
          "[class*='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']",
          "[class*='date']"
        ],
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  }
}
