{
  "retail_spec_version": "0.1",
  "code": "komplett_se",
  "name": "Komplett Sweden",
  "country": "Sweden",
  "channel": "Komplett",
  "region": "se",
  "base_url": "https://www.komplett.se",
  "currency": "SEK",
  "capabilities": [
    "price",
    "reviews"
  ],
  "generated_by": "benelux_nordic_probe/2026-09-25",
  "status": "blocked",
  "anchor": "h1, script[type='application/ld+json']",
  "shops": {
    "mode": "single_shop"
  },
  "_isomorphic": {
    "brand": "komplett",
    "reuse": "komplett_no（Komplett 各国同构：L2，spec_driven_detail）"
  },
  "_blocked": {
    "http_status": 200,
    "block_reason": "403/429/CF挑战",
    "note": "需住宅IP或代理切换"
  },
  "search": {
    "batch": {
      "max_candidates": 60
    }
  },
  "price": {
    "selectors": [
      "[class*='price']",
      "[data-testid*='price']"
    ],
    "transform": "money",
    "jsonld": false,
    "_placeholder": true,
    "price": {
      "selectors": [
        "[class*='price']",
        "[data-testid*='price']"
      ],
      "transform": "money",
      "jsonld": "offers.price"
    },
    "currency": {
      "selectors": [
        "[itemprop='priceCurrency']",
        "meta[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "jsonld": "offers.priceCurrency",
      "default": "SEK"
    },
    "list_price": {
      "selectors": [
        "[class*='old-price']",
        "[class*='original-price']",
        "s",
        "del"
      ],
      "transform": "money"
    },
    "raw_text": {
      "selectors": [
        "[class*='price']"
      ],
      "transform": "clean_text"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "on_no_match": "skip",
    "verify": {
      "require_model_in": [
        "title",
        "url"
      ],
      "min_core_len": 3
    }
  },
  "paginate": {
    "reviews": {
      "max_pages": 20
    }
  },
  "fetch": {
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "reviews": {
    "source": "jsonld",
    "container": "[itemprop='review'], [class*='review'], [data-testid*='review']",
    "limit": 40,
    "jsonld": {
      "product_type": "Product",
      "aggregateRating": "aggregateRating",
      "review_array": "review",
      "field_map": {
        "review_key": "datePublished|author.name",
        "rating": "reviewRating.ratingValue",
        "title": "name",
        "body": "description",
        "author": "author.name",
        "review_date": "datePublished"
      }
    },
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[itemprop='name']",
          "[class*='review-title']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']"
        ],
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "selectors": [
        "[itemprop='ratingValue']"
      ],
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "selectors": [
        "[itemprop='reviewCount']"
      ],
      "transform": "int"
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        "#productTitle"
      ],
      "transform": "clean_text",
      "jsonld": "name"
    },
    "brand": {
      "selectors": [
        "[itemprop='brand']",
        "[data-brand]",
        "[class*='brand']"
      ],
      "attr": "content",
      "transform": "brand",
      "jsonld": "brand.name"
    },
    "model": {
      "selectors": [
        "[itemprop='model']",
        "[data-testid*='model']",
        "[itemprop='mpn']"
      ],
      "attr": "content",
      "jsonld": "mpn",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "regex": "(\\d{2,3})\\s*(?:\"|inch|in)",
      "transform": "size_inch"
    }
  }
}
