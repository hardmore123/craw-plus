{
  "retail_spec_version": "0.1",
  "code": "paris_cl",
  "name": "Paris",
  "country": "Chile",
  "channel": "Paris",
  "region": "cl",
  "base_url": "https://www.paris.cl",
  "currency": "CLP",
  "capabilities": [
    "price",
    "reviews"
  ],
  "status": "candidate",
  "anchor": "h1",
  "generated_by": "2026-09-24 实测: Demandware/SFCC（Falabella/Paris 智利站），评价走 PDP JSON-LD Product 块（非 BV），一次返回全量（实测最多1000条，单页无翻页）",
  "_design": {
    "平台": "Demandware/SFCC（Falabella/Paris 智利站），评价不挂 BV/PowerReviews/TurnTo",
    "flixcar_is_not_reviews": "media.flixcar.com 是厂商富媒体 hotspot（图文/视频），不是用户评价，勿误判",
    "review_source": "PDP 内嵌 JSON-LD Product 块的 aggregateRating + review[]，一次返回全量（实测最多 1000 条，单页无翻页）",
    "review_fields": "review[].author.name / datePublished / description(正文) / reviewRating.ratingValue；无站内 review id",
    "agg_stale": "★aggregateRating 不可信：LG OLED 实测 review[]=1000 条但 agg.reviewCount=11、ratingValue=5，明显陈旧/子集统计。summary 必须用 review[] 实算 total_count/avg/stars，不取 aggregateRating",
    "no_reviews": "无评论时 aggregateRating 与 review 字段都缺省（留空不造假）",
    "cross_source": "部分评论 description 带 '(Fuente: tclstore.cl)' 等第三方店铺聚合来源，按原文入库即可",
    "dup_within_product": "个别产品 review[] 出现重复 description（如同款促销文案），作者/日期不同属真评论，review_key 去重自动合并"
  },
  "search": {
    "container": "a.product-item-link, .product-tile",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 6000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 40,
      "fallback_per_model": true
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        ".product-name"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[itemprop='brand']",
        "meta[itemprop='brand']"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9._\\-]{1,39})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[itemprop='sku']",
        "meta[itemprop='sku']"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        ".product-price .sales .value",
        ".price-sales",
        "[data-price]"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']",
        "meta[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "default": "CLP"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        ".product-price .strike .value",
        ".price-list",
        "[data-list-price]"
      ],
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[itemprop='availability']",
        ".availability-msg"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "jsonld",
    "_note": "解析 script[type=application/ld+json] 的 Product 块即可拿全量评价（最多1000条，单页无翻页）。review_key=sha1(sku|author|datePublished|rating|body)[:16] 前缀 'paris:'（JSON-LD 无站内 id）",
    "container": "[itemprop='review'], script[type='application/ld+json']",
    "limit": 40,
    "fields": {
      "review_key": {
        "_note": "JSON-LD 无站内 id → sha1(sku|author|datePublished|rating|description)[:16] 前缀 'paris:'"
      },
      "rating": {
        "jsonld": "reviewRating.ratingValue",
        "selectors": [
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[itemprop='name']",
          ".review-title"
        ],
        "transform": "clean_text",
        "_note": "paris JSON-LD review 通常无 title"
      },
      "body": {
        "jsonld": "description",
        "selectors": [
          "[itemprop='description']",
          ".review-body"
        ],
        "transform": "clean_text"
      },
      "author": {
        "jsonld": "author.name",
        "selectors": [
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "jsonld": "datePublished",
        "selectors": [
          "[itemprop='datePublished']"
        ],
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "summary": {
    "_note": "★summary 用 review[] 实算 total_count/avg/stars，不取 aggregateRating（陈旧/子集统计）；review[] 空才回退 agg",
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "selectors": [
        "[itemprop='ratingValue']"
      ],
      "transform": "rating",
      "_compute": "review[] 实算优先"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "selectors": [
        "[itemprop='reviewCount']"
      ],
      "transform": "int",
      "_compute": "review[] 实算优先"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3,
      "core_strip_suffix": [
        "pro",
        "max"
      ]
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto",
        "remote",
        "bracket",
        "case",
        "cover",
        "soundbar",
        "barra de sonido",
        "parlante",
        "bocina",
        "proyector",
        "projector",
        "rack",
        "antena",
        "cleaner",
        "limpiador",
        "protector",
        "pantalla"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none",
      "_note": "JSON-LD 一次返回全量（最多1000条），单页无翻页"
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": true,
    "interval_sec": 6.0,
    "retail_page_wait": "h1",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.85,
    "price_fill_rate_min": 0.9
  }
}
