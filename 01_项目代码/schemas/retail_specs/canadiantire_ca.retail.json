{
  "retail_spec_version": "0.1",
  "code": "canadiantire_ca",
  "name": "Canadian Tire",
  "country": "Canada",
  "channel": "Canadian Tire",
  "region": "ca",
  "base_url": "https://www.canadiantire.ca",
  "currency": "CAD",
  "capabilities": [
    "price",
    "reviews"
  ],
  "generated_by": "探测: canadiantire_ca PDP Samsung U79 55寸 $499.99 + 7评价节点",
  "status": "candidate",
  "anchor": "h1",
  "search": {
    "container": "a[href*='/pdp/']",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "selectors": [
        "h1",
        "[class*='product-name']",
        "[class*='title']"
      ],
      "transform": "clean_text"
    },
    "url": {
      "self_attr": "href"
    },
    "batch": {
      "max_candidates": 60
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[class*='brand']",
        "meta[itemprop='brand']"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "selectors": [
        "h1",
        "[itemprop='model']"
      ],
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[itemprop='sku']",
        "meta[itemprop='sku']"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "price": {
    "price": {
      "selectors": [
        "[data-testid*='price']",
        "[class*='price']",
        "[itemprop='price']"
      ],
      "transform": "money"
    },
    "currency": {
      "selectors": [
        "[itemprop='priceCurrency']",
        "meta[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "default": "CAD"
    },
    "in_stock": {
      "selectors": [
        "[data-testid*='availability']",
        "[itemprop='availability']"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "selectors": [
        "[class*='price']",
        "[data-testid*='price']"
      ],
      "transform": "clean_text"
    },
    "list_price": {
      "selectors": [
        "[class*='list-price']",
        "[class*='old-price']",
        "[class*='was-price']",
        "[class*='original-price']",
        "[class*='strike']",
        "s",
        "del"
      ],
      "transform": "money"
    }
  },
  "specs": [],
  "summary": {
    "avg_rating": {
      "selectors": [
        "[itemprop='ratingValue']",
        "[class*='rating']",
        "[data-testid*='rating']"
      ],
      "transform": "rating"
    },
    "total_count": {
      "selectors": [
        "[itemprop='reviewCount']",
        "[class*='review-count']"
      ],
      "attr": "content",
      "transform": "int"
    }
  },
  "reviews": {
    "container": "[class*='review'], [data-testid*='review'], [itemprop='review']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']",
          "[class*='rating']",
          "[data-testid*='rating']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']",
          "[itemprop='name']",
          "h3",
          "h4"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']",
          "[class*='review-text']",
          "p"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']",
          "[class*='review-author']",
          "[class*='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']",
          "[class*='review-date']",
          "[data-testid*='date']"
        ],
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3
    },
    "reject": {
      "title_contains_any": [
        "remote",
        "mount",
        "stand",
        "bracket",
        "cable",
        "wall mount",
        "cover",
        "case",
        "soundbar",
        "sound bar",
        "speaker",
        "sound bar/speaker",
        "subwoofer",
        "inflator",
        "vacuum",
        "canister",
        "snowblower",
        "garage",
        "blower",
        "oil",
        "engine"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "query_param",
      "param": "page",
      "max_reviews": 100,
      "max_pages": 10
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L3",
    "requires_browser": true,
    "interval_sec": 9.0,
    "retail_page_wait": "h1",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.95
  }
}
