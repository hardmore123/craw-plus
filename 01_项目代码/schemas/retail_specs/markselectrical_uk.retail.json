{
  "retail_spec_version": "0.1",
  "code": "markselectrical_uk",
  "name": "Marks Electrical",
  "country": "United Kingdom",
  "channel": "Marks Electrical",
  "region": "uk",
  "base_url": "https://www.markselectrical.co.uk",
  "currency": "GBP",
  "capabilities": [
    "price",
    "reviews"
  ],
  "status": "candidate",
  "generated_by": "2026-09-24 实测: Magento变体(Bootstrap) + Feefo 评价后端",
  "anchor": "h1",
  "search": {
    "container": ".image-box a[href]",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "selectors": [
        ".product-name",
        "h2",
        "h3"
      ],
      "transform": "clean_text"
    },
    "url": {
      "self_attr": "href"
    },
    "_note": "4K-TV子分类页有产品首页无; JSON数据岛 name:xxx price:xxx 格式",
    "batch": {
      "max_candidates": 60,
      "keyword_template": "{brand} tv"
    },
    "search_url_template": "{base}/search?keyword={q}"
  },
  "product": {
    "title": {
      "selectors": [
        "h1"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[class*='brand']",
        "[data-brand]"
      ],
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9-]{4,20})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "jsonld": "sku",
      "selectors": [
        "[itemprop='sku']"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        ".price",
        "[class*='product-price']"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "default": "GBP"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        "[class*='list-price']",
        "[class*='old-price']",
        "[class*='was-price']",
        "[class*='original-price']",
        "[class*='strike']",
        "s",
        "del"
      ],
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[itemprop='availability']",
        "button[class*='add-to-cart']:not([disabled])",
        "button[class*='buy']:not([disabled])",
        "[data-testid*='add-to-cart']:not([disabled])",
        "[class*='in-stock']",
        "[class*='disponible']"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "selectors": [
        "[class*='price']",
        "[itemprop='price']",
        "[data-price]"
      ],
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "feefo_api",
    "feefo": {
      "merchant_identifier": "marks-electrical",
      "origin": "markselectrical.co.uk",
      "summary_endpoint": "https://api.feefo.com/api/10/reviews/summary/product?product_sku={sku}&merchant_identifier=marks-electrical&origin=markselectrical.co.uk&since_period=ALL",
      "reviews_endpoint": "https://api.feefo.com/api/10/reviews/product?product_sku={sku}&merchant_identifier=marks-electrical&origin=markselectrical.co.uk&since_period=ALL&full_thread=include&page={page}",
      "page_size": 20,
      "max_pages": 20,
      "_note": "纯HTTP直连无需浏览器; product_sku=DB product.sku(如4T-C50HM5245KB)1:1; 跨商户聚合"
    },
    "container": ".feefo-review, [class*='review-item']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[class*='rating']",
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']",
          "[class*='reviewer']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']",
          "time"
        ],
        "transform": "clean_text"
      },
      "verified": {
        "selectors": [
          "[class*='verified']"
        ],
        "transform": "bool_present"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='feefo-photo'], img[class*='review-image'], .feefo-review-image img, img[itemprop='image']",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='feefo'], [class*='feefo-video'] video, [class*='review-video'] video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title",
        "sku"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "core_strip_suffix": [
        "pro",
        "max"
      ],
      "min_core_len": 4
    },
    "reject": {
      "title_contains_any": [
        "stand",
        "mount",
        "bracket",
        "cable",
        "wall mount",
        "soundbar"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none"
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": true,
    "interval_sec": 6.0,
    "retail_page_wait": "h1",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.9
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "selectors": [
        "[itemprop='ratingValue']",
        "[class*='rating-value']",
        "[class*='avg-rating']"
      ],
      "attr": "content",
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "selectors": [
        "[itemprop='reviewCount']",
        "[class*='review-count']",
        "[class*='total-review']"
      ],
      "attr": "content",
      "transform": "int"
    }
  },
  "_autofix_search": {
    "date": "2026-10-10",
    "tool": "scripts/autofix_search.py",
    "evidence": {
      "links": 12,
      "verified_models": [
        "UE75U8020HKXXU:679.0"
      ]
    },
    "tried": [
      "{base}/catalogsearch/result/?q={q} [Samsung tv] 404 links=0",
      "{base}/search?q={q} [Samsung tv] 200 links=0",
      "{base}/search?text={q} [Samsung tv] 200 links=0",
      "{base}/search?query={q} [Samsung tv] 200 links=0",
      "{base}/buscar?q={q} [Samsung tv] 404 links=0",
      "{base}/busca?q={q} [Samsung tv] 404 links=0",
      "{base}/search/?q={q} [Samsung tv] 404 links=0",
      "{base}/s?k={q} [Samsung tv] 404 links=0",
      "{base}/?s={q}&post_type=product [Samsung tv] 200 links=0",
      "{base}/{q}?_q={q}&map=ft [Samsung tv] 404 links=0",
      "{base}/search?keyword={q} [Samsung tv] 200 links=12"
    ]
  }
}
