{
  "retail_spec_version": "0.1",
  "code": "leons_ca",
  "name": "Leon's（加拿大）",
  "country": "Canada",
  "channel": "Leon's",
  "region": "ca",
  "base_url": "https://www.leons.ca",
  "currency": "CAD",
  "capabilities": [
    "price",
    "reviews"
  ],
  "generated_by": "skill probe 2026-09-17：搜索页/商品页浏览器实测",
  "status": "candidate",
  "anchor": "h1",
  "search": {
    "container": "a[href*='/products/']",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "selectors": [
        "[class*='product-title']",
        "[class*='product-name']",
        "h3",
        "a[href*='/products/']"
      ],
      "transform": "clean_text"
    },
    "url": {
      "self_attr": "href"
    },
    "batch": {
      "max_candidates": 60
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1.product-header-section",
        "h1"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[class*='brand']"
      ],
      "transform": "brand",
      "jsonld": "brand.name"
    },
    "model": {
      "selectors": [
        "h1",
        "[class*='sku']"
      ],
      "transform": "clean_text",
      "jsonld": "sku"
    },
    "size": {
      "selectors": [
        "h1",
        "[class*='product-title']"
      ],
      "transform": "size_inch"
    }
  },
  "price": {
    "price": {
      "selectors": [
        "[class*='product-price']",
        "[class*='price']"
      ],
      "transform": "money",
      "jsonld": "offers.price"
    },
    "currency": {
      "selectors": [
        "[class*='price']"
      ],
      "transform": "currency",
      "jsonld": "offers.priceCurrency",
      "default": "CAD"
    },
    "list_price": {
      "selectors": [
        "[class*='compare']",
        "[class*='was-price']",
        "s",
        "del"
      ],
      "transform": "money",
      "jsonld": "offers.highPrice"
    },
    "in_stock": {
      "selectors": [
        "[class*='add-to-cart']:not([disabled])",
        "button:has-text('Add to Cart')"
      ],
      "transform": "bool_present"
    },
    "raw_text": {
      "selectors": [
        "[class*='product-price']",
        "[class*='price']"
      ],
      "transform": "clean_text"
    }
  },
  "specs": [
    {
      "type": "table",
      "container": "table tr, [class*='spec'] tr",
      "key": "th",
      "value": "td",
      "limit": 120
    }
  ],
  "summary": {
    "avg_rating": {
      "selectors": [
        "[class*='rating']"
      ],
      "transform": "rating"
    },
    "total_count": {
      "selectors": [
        "[class*='review-count']"
      ],
      "transform": "int"
    }
  },
  "reviews": {
    "source": "lflgroup_api",
    "lfl": {
      "endpoint": "POST https://ecom.api.lflgroup.ca/ecom/item/reviews/get",
      "required_header": "x-shopify-shop-domain: www.leons.ca",
      "sku_source": "jsonld_sku",
      "page_size": 100,
      "max_pages": 30,
      "max_reviews": 2000,
      "sort": "dateDesc"
    },
    "container": "[class*='review']",
    "limit": 100,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[class*='rating']",
          "[aria-label*='star']"
        ],
        "attr": "aria-label",
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "h3",
          "[class*='review-title']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[class*='review-body']",
          "p"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[class*='author']",
          "[class*='name']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "time",
          "[class*='date']"
        ],
        "transform": "clean_text"
      },
      "review_url": {
        "selectors": []
      }
    },
    "_review_key_note": "API 模式 review_key=reviews[].id（数字）；DOM 兜底 self_attr id 缺则内容哈希",
    "_api_note": "source=lflgroup_api 时走 _leons_ca_rv8 直连 POST，不渲染 DOM；内部 SKU 从 PDP JSON-LD 提取（≠ 厂商型号），product_info.signature 非必需",
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "sku",
        "title"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "core_strip_suffix": [
        "pro",
        "max"
      ],
      "min_core_len": 4
    },
    "reject": {
      "title_contains_any": [
        "wall mount",
        "stand",
        "screen protector",
        "cable",
        "bracket",
        "adapter",
        "cover"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none",
      "max_reviews": 2000,
      "max_pages": 20
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L3_STRONG",
    "requires_browser": true,
    "interval_sec": 6.0,
    "retail_page_wait": "h1",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.95
  }
}
