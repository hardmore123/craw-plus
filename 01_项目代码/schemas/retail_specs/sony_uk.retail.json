{
  "retail_spec_version": "0.1",
  "code": "sony_uk",
  "name": "Sony UK",
  "country": "United Kingdom",
  "channel": "Sony UK",
  "region": "uk",
  "base_url": "https://www.sony.co.uk",
  "currency": "GBP",
  "capabilities": [
    "price",
    "reviews"
  ],
  "generated_by": "基于 retail/cases.jsonl 抓取经验沉淀生成（极薄适配器 + RetailSpec 驱动字段抽取）",
  "status": "candidate",
  "anchor": "h1",
  "shops": {
    "mode": "single_shop"
  },
  "_design": {
    "平台": "Sony UK 品牌官网(AEM + SAP commerceapi)，型号已在 DB（7 产品），价格走 commerceapi 产品接口，评价走 BazaarVoice BFD。",
    "PDP": "URL 形如 /bravia/products/bravia-7m2?sku=k50xr75m2pb.uka，domcontentloaded 必超时，用 wait_until=commit。",
    "价格": "GET /commerceapi/rest/v2/sony-uk/products/{sku}?currency=GBP&lang=en_GB&fields=GWX_FULL → priceData.value + stock.stockLevelStatus。",
    "评价": "BazaarVoice BFD: client=sony-global, displayCode=12872_22_0, deploymentZone=seu, locale=en_GB。BV productId 是系列 slug（bravia-7-ii）非 SKU。",
    "评价串尺寸/地区": "Sony-global 是全球 BV 客户，评价跨语言/地区聚合；summary 用 contentlocale=en_GB，reviews 抓全球全部。"
  },
  "search": {
    "container": "a[href*='/bravia/products/']",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 5000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 30,
      "fallback_per_model": true
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[data-testid='brand']",
        "meta[itemprop='brand']"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "kv": {
        "container": "[class*='spec'] tr, [class*='detail'] li",
        "key_contains": "model",
        "value": "td"
      },
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[data-sku]",
        "input[name='sku']"
      ],
      "attr": "value",
      "transform": "clean_text"
    }
  },
  "price": {
    "_note": "★Sony UK 价格不在 JSON-LD 也不在静态 HTML；走 SAP commerceapi 产品接口 priceData.value。",
    "price": {
      "selectors": [
        "[class*='Price']:not([class*='original'])",
        "[data-testid='product-price']"
      ],
      "transform": "money"
    },
    "currency": {
      "selectors": [
        "[data-testid='currency']"
      ],
      "transform": "currency",
      "default": "GBP"
    },
    "list_price": {
      "selectors": [
        "[class*='originalPrice']",
        "[class*='formerPrice']"
      ],
      "transform": "money"
    },
    "in_stock": {
      "selectors": [
        "[data-testid='add-to-cart']",
        "[class*='stock']"
      ],
      "transform": "in_stock"
    },
    "raw_text": {
      "selectors": [
        "[class*='Price']"
      ],
      "transform": "clean_text"
    },
    "api": {
      "url": "/commerceapi/rest/v2/sony-uk/products/{sku}?currency=GBP&lang=en_GB&fields=GWX_FULL",
      "price_field": "priceData.value",
      "stock_field": "stock.stockLevelStatus"
    }
  },
  "summary": {
    "avg_rating": {
      "selectors": [
        "[data-testid='rating'] .avg",
        "[class*='bv-rating']"
      ],
      "transform": "rating"
    },
    "total_count": {
      "selectors": [
        "[data-testid='review-count']",
        "[class*='bv-count']"
      ],
      "transform": "int"
    }
  },
  "reviews": {
    "_note": "★Sony UK 评价走 BazaarVoice BFD（同 Costco/sony-global 路径）。BV productId 是系列 slug（如 bravia-7-ii）非 DB sku。",
    "source": "bazaarvoice_bfd",
    "bv": {
      "client": "sony-global",
      "display_code": "12872_22_0",
      "site": "seu",
      "locale": "en_GB",
      "origin": "https://www.sony.co.uk",
      "content_locale": "en_GB",
      "page_size": 100,
      "max_pages": 20,
      "max_reviews": 1000
    },
    "container": "[class*='bv-content'], [data-bv-show='inline_rating']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']",
          "[class*='bv-rating']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='bv-content-title']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='bv-content-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']",
          "[class*='bv-author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']",
          "[class*='bv-date']"
        ],
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "match": {
    "strategy": "url_template",
    "url_template": "https://www.sony.co.uk/bravia/products/{slug}?sku={sku}",
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3
    },
    "reject": {
      "title_contains_any": [
        "soundbar",
        "projector",
        "wall mount",
        "mount",
        "bracket",
        "stand",
        "case",
        "cover",
        "remote"
      ]
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "bv_api",
      "max_reviews": 1000,
      "max_pages": 20
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "bv_exhausted_or_page_all_known"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": true,
    "interval_sec": 6.0,
    "retail_page_wait": "h1",
    "wait_until": "commit",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.8
  }
}
