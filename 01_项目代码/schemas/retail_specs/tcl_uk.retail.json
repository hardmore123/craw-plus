{
  "retail_spec_version": "0.1",
  "code": "tcl_uk",
  "name": "TCL UK",
  "country": "United Kingdom",
  "channel": "TCL UK",
  "region": "uk",
  "base_url": "https://www.tcl.com",
  "currency": "GBP",
  "capabilities": [
    "reviews"
  ],
  "generated_by": "基于 retail/cases.jsonl 抓取经验沉淀生成（极薄适配器 + RetailSpec 驱动字段抽取）",
  "status": "candidate",
  "anchor": "h1",
  "shops": {
    "mode": "single_shop"
  },
  "_design": {
    "平台": "TCL UK 品牌官网(Next.js/AEM SSR)，官网不卖货不标价（JSON-LD offers.price=''空），价格须走零售商（Currys/Amazon UK 等）。",
    "PDP": "URL 形如 /uk/en/tvs/115c7k-uk，型号从 URL slug 直接提取（115C7K-UK）。",
    "价格": "★官网无价，capabilities 不含 price，价格抓取须走零售商站。",
    "评价": "Feefo 公开 JSON API：merchant_identifier=tcl-technology, origin=www.tcl.com, locale=en_GB。product_sku=URL 末段 slug 大写（如 115C7K-UK），非 DB sku（DB 去了连字符）。",
    "评价串尺寸": "Feefo 按系列聚合：同系列不同尺寸共享评价（C7K 系列 50/55/85/98C7K-UK 均 total=625）。"
  },
  "search": {
    "container": "a[href*='/uk/en/tvs/']",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 5000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 40,
      "fallback_per_model": true
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[data-testid='brand']",
        "meta[itemprop='brand']"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "selectors": [
        "h1"
      ],
      "regex": "\\b([A-Z0-9][A-Z0-9-]{3,20})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "link[rel='canonical']"
      ],
      "attr": "href",
      "regex": "/tvs/([^/]+)/?",
      "transform": "clean_text"
    }
  },
  "summary": {
    "avg_rating": {
      "selectors": [
        "[class*='feefo'] .rating",
        "[data-testid='rating']"
      ],
      "transform": "rating"
    },
    "total_count": {
      "selectors": [
        "[class*='feefo'] .count",
        "[data-testid='review-count']"
      ],
      "transform": "int"
    }
  },
  "reviews": {
    "_note": "★TCL UK 评价走 Feefo 公开 JSON API。product_sku=PDP URL 末段 slug 大写（115C7K-UK），非 DB sku（DB 去连字符）。merchant_identifier=tcl-technology。",
    "source": "feefo",
    "feefo": {
      "merchant_identifier": "tcl-technology",
      "origin": "www.tcl.com",
      "locale": "en_GB",
      "since_period": "ALL",
      "summary_api": "https://api.feefo.com/api/10/reviews/summary/product?product_sku={product_sku}&origin=www.tcl.com&merchant_identifier=tcl-technology&since_period=ALL",
      "reviews_api": "https://api.feefo.com/api/10/reviews/product?product_sku={product_sku}&origin=www.tcl.com&merchant_identifier=tcl-technology&since_period=ALL&page_size=100&page={page}",
      "product_sku_from": "URL 末段 slug 大写（url.rstrip('/').rsplit('/',1)[-1].upper()）",
      "page_size": 100,
      "max_pages": 20,
      "max_reviews": 2000
    },
    "container": "[class*='feefo'], [data-feefo]",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "data-review-id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']",
          "[class*='feefo-rating']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='feefo-title']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='feefo-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']",
          "[class*='feefo-author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']",
          "[class*='feefo-date']"
        ],
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='feefo-photo'], img[class*='review-image'], .feefo-review-image img, img[itemprop='image']",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='feefo'], [class*='feefo-video'] video, [class*='review-video'] video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "match": {
    "strategy": "url_template",
    "url_template": "https://www.tcl.com/uk/en/tvs/{slug}",
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3
    },
    "reject": {
      "title_contains_any": [
        "soundbar",
        "projector",
        "wall mount",
        "mount",
        "bracket",
        "stand",
        "case",
        "cover",
        "remote"
      ]
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none",
      "max_reviews": 2000,
      "max_pages": 20
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "feefo_exhausted_or_page_all_known"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": true,
    "interval_sec": 6.0,
    "retail_page_wait": "h1",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.0
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "[data-testid*='price']",
        "[itemprop='price']",
        "meta[itemprop='price']",
        "[class*='price']:not([class*='old'])",
        ".price:not(.old-price)",
        ".product-price"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']",
        "meta[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "default": "GBP"
    },
    "list_price": {
      "selectors": [
        "[class*='old-price']",
        "[class*='original-price']",
        "[class*='was-price']",
        "s",
        "del"
      ],
      "transform": "money"
    },
    "raw_text": {
      "selectors": [
        "[data-testid*='price']",
        "[itemprop='price']",
        ".product-price"
      ],
      "transform": "clean_text"
    }
  }
}
