{
  "retail_spec_version": "0.1",
  "code": "amazon_us",
  "name": "Amazon",
  "country": "USA",
  "channel": "Amazon",
  "region": "us",
  "base_url": "https://www.amazon.com",
  "currency": "USD",
  "capabilities": [
    "price",
    "reviews"
  ],
  "generated_by": "反抽象: sites/amazon_us/adapter.py + schema.json",
  "status": "candidate",
  "anchor": "#productTitle",
  "search": {
    "container": "div[data-asin]:not([data-asin=''])",
    "sku": {
      "self_attr": "data-asin"
    },
    "title": {
      "selectors": [
        "h2 span:not([class])",
        "a[class*='s-line-clamp']",
        "span.a-size-medium",
        "h2 span",
        "[data-cy='title-recipe'] span"
      ],
      "transform": "clean_text"
    },
    "url_template": "https://www.amazon.com/dp/{sku}",
    "batch": {
      "prefer_pool": true,
      "search_pages": 1,
      "max_candidates": 60,
      "threshold": 20,
      "fallback_per_model": true,
      "retries": 1,
      "_note": "P1: 池优先（省逐型号搜索）+ 池内未命中回退逐型号搜索（保覆盖率）。若要极致提速可设 fallback_per_model=false，但会丢覆盖率。",
      "_measurement_2026_09_20": {
        "US 1页": "池 17 候选，命中 12/179 = 6.7%",
        "US 8页": "池 140 候选，命中 34/179 = 19.0%",
        "CA 8页": "池 304 候选，命中 31/140 = 22.1%",
        "结论": "Amazon 品牌搜索受相关性排序限制，扩页收益极低（8页也只覆盖~20%型号）。逐型号精确搜索不可省 —— 它是覆盖率的主要来源。故 search_pages=1（复用首屏免去一次重复搜索），其余型号走回退逐型号搜索。"
      }
    }
  },
  "product": {
    "title": {
      "selectors": [
        "#productTitle",
        "#title span"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "#bylineInfo",
        "a#bylineInfo",
        "#brand",
        "#detailBullets_feature_div li:has-text('Brand')"
      ],
      "transform": "brand"
    },
    "model": {
      "kv": {
        "container": "#detailBullets_feature_div li, #productDetails_techSpec_section_1 tr, #productDetails_detailBullets_sections1 tr",
        "key_contains": "model number",
        "value": "td"
      },
      "transform": "clean_text"
    },
    "category": {
      "selectors": [
        "#wayfinding-breadcrumbs_feature_div ul li:last-child a",
        "#nav-subnav a.nav-b"
      ],
      "transform": "clean_text"
    },
    "size": {
      "_note": "尺寸：优先变体选择项，其次规格表里的 Screen Size",
      "kv": {
        "container": "#productDetails_techSpec_section_1 tr, #detailBullets_feature_div li",
        "key_contains": "screen size",
        "value": "td"
      },
      "selectors": [
        "#inline-twister-expanded-dimension-text-size_name",
        "#variation_size_name .selection"
      ],
      "transform": "size_inch"
    }
  },
  "price": {
    "price": {
      "selectors": [
        "#corePrice_feature_div span.a-price span.a-offscreen",
        "#corePriceDisplay_desktop_feature_div span.a-price span.a-offscreen",
        "span.a-price span.a-offscreen",
        "#priceblock_ourprice",
        "#priceblock_dealprice",
        "[data-a-color='price'] span.a-offscreen"
      ],
      "transform": "money"
    },
    "currency": {
      "selectors": [
        "#corePrice_feature_div span.a-price span.a-offscreen",
        "span.a-price span.a-offscreen",
        "#priceblock_ourprice"
      ],
      "transform": "currency",
      "default": "USD"
    },
    "list_price": {
      "selectors": [
        "span.a-price.a-text-price span.a-offscreen",
        "#listPrice",
        "#priceblock_listprice"
      ],
      "transform": "money"
    },
    "in_stock": {
      "selectors": [
        "#availability span",
        "#availability",
        "#add-to-cart-button"
      ],
      "transform": "in_stock"
    },
    "raw_text": {
      "selectors": [
        "#corePrice_feature_div span.a-price span.a-offscreen",
        "span.a-price span.a-offscreen"
      ],
      "transform": "clean_text"
    }
  },
  "specs": [
    {
      "type": "table",
      "container": "#productDetails_techSpec_section_1 tr, #productDetails_techSpec_section_2 tr, #productDetails_detailBullets_sections1 tr",
      "key": "th",
      "value": "td",
      "limit": 120
    },
    {
      "type": "kvlist",
      "container": "#detailBullets_feature_div li",
      "limit": 120,
      "skip_keys": [
        "customer reviews",
        "best sellers rank",
        "date first available"
      ]
    }
  ],
  "summary": {
    "avg_rating": {
      "selectors": [
        "#acrPopover",
        "span[data-hook='rating-out-of-text']",
        "#averageCustomerReviews .a-icon-alt"
      ],
      "attr": "title",
      "transform": "rating"
    },
    "total_count": {
      "selectors": [
        "#acrCustomerReviewText",
        "[data-hook='total-review-count']"
      ],
      "transform": "int"
    }
  },
  "reviews": {
    "container": "[data-hook='review'], div[id][data-hook='review']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[data-hook='review-star-rating'] .a-icon-alt",
          "[data-hook='cmps-review-star-rating'] .a-icon-alt",
          "i[data-hook='review-star-rating']"
        ],
        "transform": "rating"
      },
      "title": {
        "_note": "2026-09 实测：新模板用驼峰 reviewTitle，旧模板用 review-title，两者都留",
        "selectors": [
          "[data-hook='reviewTitle']",
          "[data-hook='review-title'] span:not([class])",
          "[data-hook='review-title'] span",
          "[data-hook='review-title']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[data-hook='reviewText'] span",
          "[data-hook='reviewText']",
          "[data-hook='reviewTextContainer'] span",
          "[data-hook='review-body'] span",
          "[data-hook='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          ".a-profile-name"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[data-hook='review-date']"
        ],
        "transform": "clean_text"
      },
      "verified": {
        "selectors": [
          "[data-hook='avp-badge']"
        ],
        "transform": "bool_present"
      },
      "helpful_count": {
        "selectors": [
          "[data-hook='helpful-vote-statement']"
        ],
        "transform": "int"
      },
      "review_url": {
        "_note": "新模板 reviewTitle 是 <a><h5 data-hook=reviewTitle>，链接在外层 a；老模板 a[data-hook=review-title]",
        "selectors": [
          "a:has(h5[data-hook='reviewTitle'])",
          "a[data-hook='review-title']",
          "h5[data-hook='reviewTitle'] a",
          "a.a-link-normal.review-title-content"
        ],
        "attr": "href"
      }
    },
    "media": {
      "_note": "图片实测选择器 img[data-hook='review-image-tile']，真实图 URL 含 /images/I/，头像 avatars-global 要排除；缩略图 _SY88_ 换 _SL1600_ 拿高清",
      "images": {
        "selector": "img[data-hook='review-image-tile'], .review-image-tile img, [data-hook='review-image-tile-section'] img",
        "attr": "src",
        "include": [
          "media-amazon.com/images/I/"
        ],
        "exclude": [
          "avatars-global",
          "grey-pixel"
        ],
        "hires": [
          "\\._[A-Z]{2}[0-9]+_",
          "._SL1600_"
        ],
        "limit": 30
      },
      "videos": {
        "selector": "video[data-hook='review-video'] source, [data-hook='review-video'] video, video.review-video source",
        "attr": "src",
        "exclude": [],
        "limit": 10
      }
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "sku",
        "title"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "core_strip_suffix": [
        "pro",
        "max"
      ],
      "min_core_len": 4
    },
    "reject": {
      "title_contains_any": [
        "case",
        "cover",
        "wall mount",
        "stand",
        "screen",
        "bracket",
        "protector",
        "cable",
        "adapter",
        "remote",
        "control",
        " controller",
        "mount",
        "screw",
        "charger",
        "antenna",
        "cleaner",
        "replacement",
        "compatible",
        "for hisense",
        "fit for",
        "soporte",
        "base para"
      ],
      "url_contains_any": [],
      "_expanded_2026_09_20": "实测：逐型号回退路径原先未做 reject 校验，导致 Remote Control / Wall Mount Bracket / Screws 等配件作为电视入库；已补 reject + 扩充词表（remote/control/mount/bracket/screw/replacement 等）。"
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "_verified_2026_09_20": {
        "结论": "★filter_sweep 在 amazon.com **不生效** —— 6 个 combo 返回完全相同的 8 条（id 交集 8/8）",
        "实测证据": {
          "样本": "B0FHLGWJNS / B0HBWF1WWH / B0GR9BLPJ8 / B0HBW7QZRC",
          "现象": "sortBy=recent|helpful、filterByStar=positive|critical|five_star|one_star 全部返回同一批 8 条；评价页无分页控件（li.a-last=0）",
          "对比": "同页 PDP 首屏也是 8 条 → 8 是硬上限，不是'只有 8 条'",
          "关键反例": "B0FHLGWJNS 的 #acrCustomerReviewText = (2,740)，但只能取到 8 条；B0HBWF1WWH=(10)→8 条；B0GR9BLPJ8=(42)→8 条",
          "结论": "amazon.com 评价页对登录会话也只渲染 8 条，且不接受 sortBy/filterByStar 增量"
        },
        "为什么与 CA 不同": "amazon.ca 同型号 43E6SF（总评分 87）用 combo 扫描可取 34 条、32A4NV 可取 50 条；.com 无此行为。跨国别不可想当然复用，必须逐站实测",
        "当前实际能力": "每型号 8 条（= PDP 首屏），保持 filter_sweep 配置不产生额外请求成本也无收益；保留以便 .com 行为变化时自动受益",
        "价格链路": "正常。实测 4 个候选全部取到真实价：$297.97 / $209.99 / $278.99 / $428.99",
        "登录": {
          "方式": "python -m overseas.cli login --site amazon_us --profile --url https://www.amazon.com/",
          "凭证 cookie": "at-main / sess-at-main / x-main（无国别后缀）",
          "权威校验": "/gp/css/order-history 不跳 /ap/signin ⇒ 真登录（已实测通过）"
        }
      },
      "type": "filter_sweep",
      "url_template": "{base}/product-reviews/{sku}/?reviewerType=all_reviews&sortBy={sortBy}&filterByStar={filterByStar}&pageNumber=1",
      "combos": [
        {
          "sortBy": "recent",
          "filterByStar": ""
        },
        {
          "sortBy": "helpful",
          "filterByStar": ""
        },
        {
          "sortBy": "recent",
          "filterByStar": "positive"
        },
        {
          "sortBy": "recent",
          "filterByStar": "critical"
        },
        {
          "sortBy": "recent",
          "filterByStar": "five_star"
        },
        {
          "sortBy": "recent",
          "filterByStar": "four_star"
        },
        {
          "sortBy": "recent",
          "filterByStar": "three_star"
        },
        {
          "sortBy": "recent",
          "filterByStar": "two_star"
        },
        {
          "sortBy": "recent",
          "filterByStar": "one_star"
        },
        {
          "sortBy": "helpful",
          "filterByStar": "positive"
        },
        {
          "sortBy": "helpful",
          "filterByStar": "critical"
        }
      ],
      "no_new_combos_cap": 4,
      "max_reviews": 50,
      "max_pages": 12,
      "first_screen_cap": 8,
      "_first_screen_cap_2026_09_20": {
        "依据": "实测 amazon.com 对登录会话也只渲染 8 条（总评分 2,742 的产品同样只给 8 条；总评分 10/42 也是 8 条），且无分页控件",
        "效果": "PDP 首屏已达 8 条即直接返回，跳过 11 组合扫描；实测可省 ~35s/型号（占单型号耗时约一半）",
        "风险": "若 Amazon 未来放开上限，此配置会变成上限瓶颈 —— 移除该键即可恢复完整扫描"
      }
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L3",
    "requires_browser": true,
    "interval_sec": 8.0,
    "retail_page_wait": "body",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.95
  },
  "_price_region_fix_2026_09_20": {
    "修复": "价格抽取改为共用实现 overseas/sites/amazon_common.py::parse_amazon_product",
    "原因": "32A4NV（B0F34L9MZB）无 buybox 主价时，页面 18 个 .a-price 全来自推荐位/配件轮播，裸兜底选择器把配件价当成电视价（$9.49，且每次跑值都不同）",
    "判据": "价格元素必须位于核心价格区/买盒内，祖先链不得含推荐位容器（p13n/a-carousel/_c2Itb_ 等）",
    "收益": "无主价的商品正确留空，不再写入配件价"
  }
}
