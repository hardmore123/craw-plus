{
  "retail_spec_version": "0.1",
  "code": "cresa_ec_more",
  "name": "Cresa More",
  "country": "Ecuador",
  "channel": "Cresa More",
  "region": "ec",
  "base_url": "https://www.crecos.com",
  "currency": "USD",
  "capabilities": [
    "price"
  ],
  "status": "candidate",
  "generated_by": "2026-09-23 实测: VTEX Catalog API (crecos.com), 姐妹站 cresa_ec 的'更多产品'分支站",
  "anchor": "body",
  "search": {
    "container": "body",
    "api_path": "/api/catalog_system/pub/products/search?ft={q}&_from={from}&_to={to}",
    "_note": "VTEX Catalog API, _from/_to 闭区间单页最多50; resp.read() 全量读取不限大小",
    "sku": {
      "self_attr": "productId"
    },
    "title": {
      "jsonld": "productName",
      "transform": "clean_text"
    },
    "url": {
      "jsonld": "link",
      "transform": "clean_text"
    },
    "batch": {
      "max_candidates": 60,
      "keyword_template": "{brand} televisor"
    },
    "api": {
      "type": "vtex_catalog",
      "_note": "detect_search_api.py 2026-10-08 实测接口可用；搜索候选走 VTEX Catalog API，详情页仍按 product/price 段抽取"
    }
  },
  "product": {
    "title": {
      "jsonld": "productName",
      "transform": "clean_text"
    },
    "brand": {
      "jsonld": "brand",
      "transform": "brand"
    },
    "model": {
      "regex": "\\b(\\d{1,4}[A-Z][A-Z0-9]{1,10})\\b",
      "transform": "clean_text"
    },
    "size": {
      "regex": "\\b(\\d{2})\\s*[ pulgadas inch]+\\b",
      "transform": "size_inch"
    },
    "sku": {
      "jsonld": "productId",
      "transform": "clean_text"
    }
  },
  "price": {
    "price": {
      "jsonld": "items[0].sellers[0].commertialOffer.Price",
      "transform": "money"
    },
    "list_price": {
      "jsonld": "items[0].sellers[0].commertialOffer.ListPrice",
      "transform": "money"
    },
    "currency": {
      "jsonld": "items[0].sellers[0].commertialOffer.PriceCurrency",
      "transform": "currency"
    },
    "in_stock": {
      "jsonld": "items[0].sellers[0].commertialOffer.AvailableQuantity",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "selectors": [
        "[class*='price']",
        "[itemprop='price']",
        "[data-price]"
      ],
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "none",
    "_note": "VTEX GraphQL reviews-and-ratings; 探测确认评价数=0则留空不造假",
    "container": "[class*='review'], [itemprop='review']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']"
        ],
        "transform": "clean_text"
      }
    },
    "reason": "已确认全站零评价：REST /reviews-and-ratings/api/reviews 200 + total=0（app 已装）。_partial_reviews_fix 复确认。capabilities 移除 reviews。",
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 60,
    "verify": {
      "require_model_in": [
        "title",
        "sku"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "core_strip_suffix": [
        "pro",
        "max"
      ],
      "min_core_len": 3
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none"
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": false,
    "detail_http": true,
    "_note": "VTEX API 直连, 代理拒绝可回退直连; resp.read() 不限大小",
    "interval_sec": 6.0,
    "retail_page_wait": "body",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.95
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "selectors": [
        "[itemprop='ratingValue']",
        "[class*='rating-value']",
        "[class*='avg-rating']"
      ],
      "attr": "content",
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "selectors": [
        "[itemprop='reviewCount']",
        "[class*='review-count']",
        "[class*='total-review']"
      ],
      "attr": "content",
      "transform": "int"
    }
  }
}
