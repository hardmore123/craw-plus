{
  "retail_spec_version": "0.1",
  "code": "tcl_cl",
  "name": "TCL（智利）",
  "country": "Chile",
  "channel": "TCL 官网",
  "region": "cl",
  "base_url": "https://tclstore.cl",
  "currency": "CLP",
  "capabilities": [
    "price"
  ],
  "generated_by": "SA4 任务实测生成 (2026-09-27)：BrowserFetcher(human_like=True) 200 OK；Shopify collection /collections/tv 分页 ?page=N；24 个 productitem 卡片；价格 .productitem__price .money (CLP $N.NNN.NNN)；评价聚合 aria-label 无单条明细；反爬脚本含 access denied 字样需 adapter 白名单豁免",
  "status": "candidate",
  "anchor": "h1, .productitem__price",
  "search": {
    "container": ".productitem, a[href*='/collections/tv/products/']",
    "sku": {
      "selectors": [
        "a[href*='/collections/tv/products/']"
      ],
      "attr": "href"
    },
    "title": {
      "selectors": [
        ".productitem--title"
      ],
      "transform": "clean_text"
    },
    "url": {
      "selectors": [
        "a[href*='/collections/tv/products/']"
      ],
      "attr": "href"
    },
    "wait_ms": 4000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 60,
      "fallback_per_model": true
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        ".product-single__title"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "meta[itemprop='brand']",
        "[data-shopify-brand]"
      ],
      "attr": "content",
      "transform": "brand",
      "jsonld": "brand.name"
    },
    "model": {
      "selectors": [
        "h1",
        "[itemprop='model']",
        "[itemprop='mpn']"
      ],
      "transform": "clean_text",
      "jsonld": "model"
    },
    "size": {
      "selectors": [
        "h1",
        ".product-single__title"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "meta[itemprop='sku']",
        "[data-variant-id]"
      ],
      "attr": "content",
      "transform": "clean_text",
      "jsonld": "sku"
    }
  },
  "price": {
    "price": {
      "selectors": [
        ".productitem__price .money",
        ".price .money",
        ".product-single__price .money"
      ],
      "transform": "money",
      "jsonld": "offers.price"
    },
    "currency": {
      "selectors": [
        "[data-currency]",
        "meta[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "jsonld": "offers.priceCurrency",
      "default": "CLP"
    },
    "list_price": {
      "selectors": [
        ".productitem__price--compare .money",
        ".price--compare .money",
        "s .money"
      ],
      "transform": "money",
      "jsonld": "offers.highPrice"
    },
    "in_stock": {
      "selectors": [
        "[data-availability]",
        ".product-form__inventory"
      ],
      "attr": "data-availability",
      "transform": "in_stock",
      "jsonld": "offers.availability"
    },
    "raw_text": {
      "selectors": [
        ".productitem__price",
        ".price"
      ],
      "transform": "clean_text"
    }
  },
  "specs": [],
  "summary": {
    "avg_rating": {
      "selectors": [
        "[aria-label*='estrella']",
        ".spr-starrating"
      ],
      "transform": "rating"
    },
    "total_count": {
      "selectors": [
        "[aria-label*='reseña']",
        ".spr-summary-caption"
      ],
      "transform": "int"
    }
  },
  "reviews": {
    "container": ".spr-review, [itemprop='review']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          ".spr-review-rating",
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          ".spr-review-header-title",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          ".spr-review-content-body",
          "[itemprop='reviewBody']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          ".spr-review-header-byline",
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          ".spr-review-header-byline",
          "[itemprop='datePublished']"
        ],
        "transform": "clean_date"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "core_strip_suffix": [
        "pro",
        "max"
      ],
      "min_core_len": 3
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto",
        "remote",
        "bracket",
        "case",
        "cover",
        "soundbar",
        "barra de sonido",
        "parlante",
        "bocina",
        "proyector",
        "rack",
        "antena"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none"
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": true,
    "interval_sec": 6.0,
    "retail_page_wait": "h1, .productitem__price",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.9
  }
}
