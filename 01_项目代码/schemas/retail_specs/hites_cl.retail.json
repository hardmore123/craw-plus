{
  "retail_spec_version": "0.1",
  "code": "hites_cl",
  "name": "Hites",
  "country": "Chile",
  "channel": "Hites",
  "region": "cl",
  "base_url": "https://www.hites.com",
  "currency": "CLP",
  "capabilities": [
    "price",
    "reviews"
  ],
  "status": "candidate",
  "anchor": "h1",
  "generated_by": "2026-09-24 实测: Demandware/SFCC（on/demandware.static），评价走智利本地平台 verificado.ai cache API 直连（HttpFetcher 即可，token 静态）",
  "_design": {
    "平台": "Demandware/SFCC（hites.com 智利站）",
    "yotpo_present_but_unused": "PDP 内嵌 yotpo app_key=3f9ff92b-c13a-448c-a196-4da48a114d66，但评价区非 yotpo 渲染（widget 不加载，data-product-id 空）",
    "review_backend": "verificado.ai（智利/拉美评价平台，seller_id=hites），PDP 内嵌 verificado widget JS",
    "jsonld_empty": "★PDP JSON-LD Product 块无 aggregateRating / review[] 字段（与 paris_cl 不同，不能走 JSON-LD）",
    "api": "cache.verificado.ai/reviews/<SELLER_TOKEN>/product/<SKU>/filter/0/sort/mps/page/<LIMIT>.<OFFSET> —— 可直连 JSON，不需浏览器渲染评价区",
    "seller_token": "lxYg9hRtmvWOlJyJxOFE5PezUh50XWlDp6ZVlqJytNWATHbyd8n6zykmadOc（对 Hites 静态，= seller_id 鉴权串）",
    "product_id": "用 product.sku 直接作 product id（与站内商品号一致，无需映射）",
    "pagination_trap": "★★page/<N> 的 N 是每页条数上限但 reviews_jsonld 单页硬上限 10 条！必须用 /page/<LIMIT>.<offset> 形态翻页（offset 递增 LIMIT）才能取全量（实测 total=88 的 SKU 用 page/100 只回 10 条）",
    "review_fields": "data.reviews_jsonld[] = {author, rating(int 1-5), text(正文,可为 null), date(ISO8601 带时区)}；无站内 review id、无标题",
    "summary_fields": "data.average_rating(float,可信) + data.total_reviews(int,可信)；stars 分布由 reviews_jsonld 实算",
    "no_reviews": "无评价返回 data.error='No reviews found for SKU <SKU>' + total_reviews=0 → 留空不造假",
    "origin_required": "请求带 Origin/Referer 指向 hites.com（为稳一律带）"
  },
  "search": {
    "container": "a.product-item-link, .product-tile",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 6000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 40,
      "fallback_per_model": true
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        ".product-name"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[itemprop='brand']",
        "meta[itemprop='brand']"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9._\\-]{1,39})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[itemprop='sku']",
        "meta[itemprop='sku']",
        "[data-product-id]"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        ".product-price .sales .value",
        ".price-sales"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']",
        "meta[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "default": "CLP"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        ".product-price .strike .value",
        ".price-list"
      ],
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[itemprop='availability']",
        ".availability-msg"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "verificado_ai_api",
    "seller_token": "lxYg9hRtmvWOlJyJxOFE5PezUh50XWlDp6ZVlqJytNWATHbyd8n6zykmadOc",
    "_note": "直连 cache.verificado.ai/reviews/<token>/product/<sku>/filter/0/sort/mps/page/9.<offset> 取 reviews_jsonld。★★关键陷阱：page/<N> 的 N 看似每页条数但 reviews_jsonld 单页硬上限 10 条，必须用 /page/<LIMIT>.<offset> 翻页（offset 递增 LIMIT=9）才能取全量。token 对 seller 静态。无评价留空不造假。reviews_jsonld[].text 可为 null（只打分不写正文），按 (author,date) 去重可无冲突补缺。Origin/Referer 指向 hites.com 必带",
    "container": "[class*='review'], [itemprop='review']",
    "limit": 40,
    "fields": {
      "review_key": {
        "_note": "verificado 无站内 id → sha1(sku|author|date|rating|text)[:16] 前缀 hites_verificado:"
      },
      "rating": {
        "jsonld": "rating",
        "transform": "rating"
      },
      "title": {
        "_note": "verificado 无标题字段"
      },
      "body": {
        "jsonld": "text",
        "transform": "clean_text"
      },
      "author": {
        "jsonld": "author",
        "transform": "clean_text"
      },
      "review_date": {
        "jsonld": "date",
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "summary": {
    "_note": "用 API 的 average_rating + total_reviews；stars 由 reviews_jsonld 实算（不依赖 API 直方图）",
    "avg_rating": {
      "jsonld": "average_rating",
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "total_reviews",
      "transform": "int"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3,
      "core_strip_suffix": [
        "pro",
        "max"
      ]
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto",
        "remote",
        "bracket",
        "case",
        "cover",
        "soundbar",
        "barra de sonido",
        "parlante",
        "bocina",
        "proyector",
        "projector",
        "rack",
        "antena",
        "cleaner",
        "limpiador",
        "protector",
        "pantalla"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none",
      "max_reviews": 500,
      "max_pages": 20,
      "limit": 9,
      "_note": "offset 递增 LIMIT=9，直到空页/全重复/达 total_reviews"
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": false,
    "detail_http": true,
    "interval_sec": 6.0,
    "retail_page_wait": "h1",
    "_note": "verificado cache API 直连 HTTP(带 Origin/Referer)即可，不需浏览器/stealth；stealth 对人评价值有限，API 路径更稳。浏览器只在需探测 token 时用",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.9
  }
}
