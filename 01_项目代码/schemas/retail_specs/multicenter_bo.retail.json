{
  "retail_spec_version": "0.1",
  "code": "multicenter_bo",
  "name": "Multicenter",
  "country": "Bolivia",
  "channel": "Multicenter",
  "region": "bo",
  "base_url": "https://www.multicenter.com",
  "currency": "BOB",
  "capabilities": [
    "price"
  ],
  "status": "candidate",
  "anchor": "h1",
  "generated_by": "2026-09-24 实测: VTEX 站(Bolivia, bindingId=86ac3f64..., locale=es-BO)，未装 vtex.reviews-and-ratings app（reviews 字段 GraphQL validation failed）",
  "_design": {
    "平台": "VTEX (www.multicenter.com, Bolivia 零售站, bindingId=86ac3f64-5f1b-4149-a9d1-4a962b30de6e, locale=es-BO)",
    "review_backend": "无——未安装 vtex.reviews-and-ratings app，无 BV/Yotpo/PowerReviews/TurnTo/Feefo 第三方挂件",
    "vtex_app_detection": "★判定 VTEX 站是否装 reviews-and-ratings：直接 POST totalReviewsByProductId 查询到 /_v/public/graphql/v1，返 400 GraphQL validation failed=未装(字段不存在)；返 200+data=已装。比试 persistedQuery hash 更直接(hash 未知时返 PERSISTED_QUERY_NOT_FOUND 不区分未装 vs hash 变)",
    "pdp_dom": "滚动6次+长等后 [id*=review]/[class*=review]/[data-testid*=review] 全 0；无 Escribir una reseña/Sea el primero/Opiniones/Reseñas 文案",
    "jsonld": "PDP 2 个 JSON-LD 块(Product+BreadcrumbList)，Product 块无 aggregateRating、无 review 数组(6/6 产品一致)",
    "bv_probe": "apps.bazaarvoice.com/deployments/{multicenter}/{multicenter,multicenter-bo,multicenter_bo}/production/es_BO/bv.js 全 404，无自有 BV 部署",
    "sku_is_vtex_pid": "DB product.sku(57530/55695/...)即 VTEX productId，直接当 GraphQL productId 用(与 orvehogar_ec/exito_co 同)",
    "currency": "BOB"
  },
  "search": {
    "container": "a[href*='/p'], .vtex-product-summary",
    "_note": "VTEX 站搜索页",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 6000,
    "batch": {
      "keyword_template": "{brand} televisor",
      "max_candidates": 40,
      "fallback_per_model": true
    },
    "api": {
      "type": "vtex_catalog",
      "_note": "detect_search_api.py 2026-10-08 实测接口可用；搜索候选走 VTEX Catalog API，详情页仍按 product/price 段抽取"
    }
  },
  "product": {
    "title": {
      "jsonld": "productName",
      "selectors": [
        "h1",
        ".vtex-product-summary-name"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "jsonld": "brand",
      "selectors": [
        ".vtex-product-brand"
      ],
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9._\\-]{1,39})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "jsonld": "productId",
      "selectors": [
        "[itemprop='sku']",
        "meta[itemprop='sku']"
      ],
      "attr": "content",
      "transform": "clean_text",
      "_note": "VTEX productId"
    }
  },
  "price": {
    "price": {
      "jsonld": "items[0].sellers[0].commertialOffer.Price",
      "selectors": [
        ".vtex-product-price"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "items[0].sellers[0].commertialOffer.PriceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "default": "BOB"
    },
    "list_price": {
      "jsonld": "items[0].sellers[0].commertialOffer.ListPrice",
      "selectors": [
        ".vtex-product-list-price"
      ],
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "items[0].sellers[0].commertialOffer.AvailableQuantity",
      "selectors": [
        "[itemprop='availability']"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "none",
    "_note": "★未装 vtex.reviews-and-ratings app：POST totalReviewsByProductId 查询到 /_v/public/graphql/v1 返 400 GraphQL validation failed（字段不存在=app 未装）。无评价不写 review 不写 review_summary，只留 retail_task_status(no_reviews)+ crawl_run。探测顺序：PDP评价区DOM(0)→JSON-LD aggregateRating(无)→BV挂件(404无部署)→VTEX GraphQL(reviews 字段 validation failed=未装app)→第三方API(无)",
    "container": "[class*='review'], [itemprop='review']",
    "limit": 0,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']"
        ],
        "transform": "clean_text"
      }
    },
    "reason": "已确认无评价基础设施：REST /reviews-and-ratings/api/reviews 404（reviews-and-ratings app 未装）。_partial_reviews_fix 复确认。capabilities 移除 reviews。",
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "transform": "int"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3,
      "core_strip_suffix": [
        "pro",
        "max"
      ]
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto",
        "remote",
        "bracket",
        "case",
        "cover",
        "soundbar",
        "barra de sonido",
        "parlante",
        "bocina",
        "proyector",
        "projector",
        "rack",
        "antena",
        "cleaner",
        "limpiador",
        "protector",
        "pantalla"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none"
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": false,
    "detail_http": true,
    "interval_sec": 6.0,
    "retail_page_wait": "h1",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.85,
    "price_fill_rate_min": 0.9,
    "reviews": "no reviews-and-ratings app installed, leave empty"
  }
}
