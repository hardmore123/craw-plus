{
  "retail_spec_version": "0.1",
  "code": "artefacta_ec",
  "name": "Artefacta",
  "country": "Ecuador",
  "channel": "Artefacta",
  "region": "ec",
  "base_url": "https://www.artefacta.com",
  "currency": "USD",
  "capabilities": [
    "price",
    "reviews"
  ],
  "status": "candidate",
  "anchor": "h1",
  "generated_by": "2026-09-24 实测: Magento 站托 Fastly/Varnish CDN，数据中心 IP 全 405 Error 54113 硬封；Wayback 快照兜底可抓（分类页 data-price-amount + PDP JSON-LD）",
  "_design": {
    "平台": "Magento（厄瓜多尔），托 Fastly/Varnish CDN",
    "reachability": "★所有可用出口对 PDP 与首页均返回 HTTP 405 'Error 54113' / 'Varnish cache server'：US 代理(Sharktech AS46844 数据中心)、本机直连、web_fetch 出口全部 405；Fastly 边缘节点 NRT/SIN/BUR 轮换但一致拒绝。属 CDN 层 IP/ASN 硬封，非 JS 挑战（Chrome/Googlebot/Mobile UA、Sec-Fetch、es-PE locale、human_like、persistent profile 全无效，真实 Chromium 同样 405）",
    "google_indexed": "Google 已索引该站 product 详情页，说明住宅 IP 可访问，封的是数据中心 IP 段",
    "wayback_fallback": "live 站 IP 封禁时经 Wayback Machine 抓存档快照：分类页 product-item-link 取标题/path + data-price-amount 取价(min=final/max=list_price USD)；PDP JSON-LD Product 富集 brand/sku。价格为快照时点非实时",
    "review_source_unknown": "因全站 405，PDP 评价区/JSON-LD/BV 挂件/VTEX GraphQL/第三方 API 均无法探测到（连 HTML 都拿不到）。需住宅 IP 可达后才能定评价来源",
    "block_marker": "建议把 'error 54113'/'varnish cache server' 加入 infra.py _BLOCK_MARKERS"
  },
  "search": {
    "container": "a.product-item-link, .product-item",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 6000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 40,
      "fallback_per_model": true
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        ".page-title"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[itemprop='brand']",
        "meta[itemprop='brand']"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9._\\-]{1,39})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[itemprop='sku']",
        "meta[itemprop='sku']"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "[data-price-amount]",
        ".price"
      ],
      "attr": "content",
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']",
        "meta[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "default": "USD"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        "[data-price-amount]",
        ".old-price"
      ],
      "attr": "content",
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[itemprop='availability']",
        ".stock"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "unknown_blocked",
    "_note": "★全站 405 硬封，评价来源无法探测。需住宅/拉美出口 IP 可达 PDP 后再定（可能走 PDP JSON-LD aggregateRating 或第三方挂件）",
    "container": "[class*='review'], [itemprop='review']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']"
        ],
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "transform": "int"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3,
      "core_strip_suffix": [
        "pro",
        "max"
      ]
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto",
        "remote",
        "bracket",
        "case",
        "cover",
        "soundbar",
        "barra de sonido",
        "parlante",
        "bocina",
        "proyector",
        "projector",
        "rack",
        "antena",
        "cleaner",
        "limpiador",
        "protector",
        "pantalla"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none"
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": true,
    "interval_sec": 6.0,
    "retail_page_wait": "h1",
    "_note": "★需住宅/拉美出口 IP；数据中心 IP 被 Fastly/Varnish 405 硬封。Wayback 快照兜底取价但非实时",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.7,
    "price_fill_rate_min": 0.8,
    "_note": "因 IP 封禁预期值下调"
  }
}
