{
  "retail_spec_version": "0.1",
  "code": "expert_de",
  "name": "Expert DE",
  "country": "Germany",
  "channel": "Expert DE",
  "region": "de",
  "base_url": "https://www.expert.de",
  "currency": "EUR",
  "capabilities": [
    "price",
    "reviews"
  ],
  "generated_by": "基于 retail/cases.jsonl 抓取经验沉淀生成（极薄适配器 + RetailSpec 驱动字段抽取）",
  "status": "candidate",
  "anchor": "h1",
  "shops": {
    "mode": "single_shop"
  },
  "_design": {
    "平台": "Expert DE (Nuxt.js SSR + Cloudflare JS challenge)，型号已在 DB（100 产品），价格在 exp_price 元素（EUR），评价 BazaarVoice 但被 Cloudflare 拦截(needs_human)。",
    "发现": "★sitemap 确定性发现：https://www.expert.de/sitemap.xml -> /sitemap/urls/produkte/tv-audio.xml(4.5MB, 13653 URL) 含 1144 个电视 PDP；urllib 直抓 sitemap 无 CF。",
    "PDP": "PDP(www.expert.de) Playwright domcontentloaded 即含 <title>/<h1>/exp_price 价格/__NUXT_DATA__(含品牌/型号/EAN/标题)，无 CF 挑战。",
    "价格": "class='...exp_price text-tertiary...' 元素，德语格式 513.99 / 1.299.- / 499,-；formerPrice=划线原价；配件(5.50 pro Monat)也是 exp_price 需按 >50 过滤。",
    "评价": "★BazaarVoice inline_rating 挂件是服务端渲染死标记：BV loader 永不加载（_nuxt chunk 被 CF JS challenge 拦），评价区对爬虫不可见 → needs_human。"
  },
  "discovery": {
    "_note": "★robots 合规：sitemap 确定性发现，不依赖搜索（Cloudflare 拦截）。",
    "sitemap": {
      "url": "https://www.expert.de/sitemap.xml",
      "child": "/sitemap/urls/produkte/tv-audio.xml",
      "pdp_count": 1144,
      "pdp_format": "/shop/.../fernseher/lcd-led-fernseher/<11位webcode>-<slug>.html"
    }
  },
  "search": {
    "container": "a[href*='/shop/']",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 5000,
    "batch": {
      "keyword_template": "{brand} fernseher",
      "max_candidates": 60,
      "fallback_per_model": true,
      "_note": "搜索可能被 CF 拦，优先用 sitemap 发现"
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        "title"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[data-testid='brand']",
        "meta[itemprop='brand']"
      ],
      "attr": "content",
      "transform": "brand",
      "_note": "标题正则词表匹配兜底（LG/Samsung/Sony/Philips/Metz/Loewe/Toshiba/TCL/Panasonic/Telefunken）"
    },
    "model": {
      "selectors": [
        "[data-testid='model']",
        "[itemprop='model']"
      ],
      "attr": "content",
      "regex": "\\b([A-Z0-9][A-Z0-9-]{4,20})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch",
      "_note": "德语 (\\d{2,3})\\s*(Zoll|cm|inch)"
    },
    "sku": {
      "selectors": [
        "[data-testid='sku']",
        "[itemprop='sku']"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "price": {
    "price": {
      "selectors": [
        ".exp_price",
        "[class*='exp_price']"
      ],
      "transform": "money",
      "_note": "德语格式 513.99 / 1.299.- / 499,-；过滤 <50 的配件价"
    },
    "currency": {
      "selectors": [
        "[class*='exp_price']"
      ],
      "transform": "currency",
      "default": "EUR"
    },
    "list_price": {
      "selectors": [
        ".exp_price .formerPrice",
        "[class*='formerPrice']"
      ],
      "transform": "money"
    },
    "in_stock": {
      "selectors": [
        "[data-testid='add-to-cart']",
        ".in-stock"
      ],
      "transform": "in_stock"
    },
    "raw_text": {
      "selectors": [
        ".exp_price"
      ],
      "transform": "clean_text"
    }
  },
  "summary": {
    "_note": "★评价区被 Cloudflare 拦截，BV 不 hydrate，summary 抓不到。needs_human。",
    "avg_rating": {
      "selectors": [
        "[data-bv-show='inline_rating'] .bv-rating",
        "[class*='bv-rating']"
      ],
      "transform": "rating"
    },
    "total_count": {
      "selectors": [
        "[data-bv-show='inline_rating'] .bv-count",
        "[class*='bv-count']"
      ],
      "transform": "int"
    }
  },
  "reviews": {
    "_note": "★BazaarVoice inline_rating 挂件是服务端渲染死标记：BV loader 永不加载（_nuxt chunk 被 CF JS challenge 拦），评价区对爬虫不可见。verdict=needs_human。无可见评价时按红线留空不造假。",
    "source": "bazaarvoice_blocked",
    "container": "[data-bv-show='inline_rating'], [class*='bv-content']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']",
          "[class*='bv-rating']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='bv-content-title']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='bv-content-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']",
          "[class*='bv-author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']",
          "[class*='bv-date']"
        ],
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 60,
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3
    },
    "reject": {
      "title_contains_any": [
        "soundbar",
        "projektor",
        "wandhalterung",
        "halterung",
        "standfuß",
        "kabel",
        "fernbedienung",
        "zubehör"
      ]
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none",
      "max_reviews": 0,
      "max_pages": 0,
      "_note": "评价被 CF 拦，不翻页"
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "fetch": {
    "protection": "L3",
    "requires_browser": true,
    "interval_sec": 6.0,
    "retail_page_wait": "h1",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.7
  }
}
