{
  "retail_spec_version": "0.1",
  "code": "costco_us",
  "name": "Costco",
  "country": "USA",
  "channel": "Costco",
  "region": "us",
  "base_url": "https://www.costco.com",
  "currency": "USD",
  "capabilities": [
    "price",
    "reviews"
  ],
  "generated_by": "2026-09-20 实测重写: 搜索 SPA(浏览器,24 候选) + PDP 服务端渲染(HTTP) + BazaarVoice 接口(18 评价)",
  "status": "candidate",
  "_design_2026_09_20": {
    "访问条件": "★非美国出口 IP 直接 403 Access Denied（IP 层，与请求头无关）。必须配美国线路，先跑 scripts/diag_retail_search.py --site costco_us 确认。",
    "搜索页": "https://www.costco.com/s?keyword=<kw>（/CatalogSearch 会 301 到此）。Next.js 客户端渲染，必须浏览器 + 滚动 + 等待。",
    "商品页": "服务端渲染，纯 HTTP 可拿。价格只在 JSON-LD（实测 55\" QD7：$279.99 USD）。",
    "型号": "页头 `Item 9655750 | Model 55QD75SFC` 与规格表 Model 一致；由 sites/costco_common.py 收进 product.model_candidates 精确校验。",
    "网评": "BazaarVoice 客户端接口（overseas/bv_reviews.py），纯 HTTP 可取；实测 18 条。",
    "型号口径差异": "★Costco 卖的是渠道专供型号（US 上架 55QD75SFC，品牌官网清单里是 55QD7QF），按核心串匹配不上是**正常结果**，记 no_item，不要放宽到系列匹配去凑数。"
  },
  "anchor": "h1",
  "search": {
    "container": "a[href*='.product.']",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 10000,
    "scroll_passes": 20,
    "_scroll_note": "★US 站滚动次数不足会只拿到部分候选（实测滚 3 次只有 8 个，滚 20 次才 24 个），漏掉的型号会被错判成 no_item。",
    "batch": {
      "_note": "★美国站搜索页更慢（渲染 + 滚动要 10 秒以上），force=true + fallback_per_model=false 是避免 179 个 Hisense 型号逐个搜的关键。",
      "keyword_template": "{brand} tv",
      "threshold": 40,
      "force": true,
      "fallback_per_model": false,
      "max_candidates": 60,
      "max_search_failures": 2,
      "_min_candidates_note": "★US 站的搜索页抖动明显：同一 URL 实测 24 / 9 / 0 个候选三态。低于下限一律判为搜索失败（记 failed 并跳过品牌），绝不写 no_item——否则会把'没抓到'静默写成'Costco 没上架'。",
      "min_candidates": 15,
      "retries": 3,
      "_resolve_models_note": "★同 CA：列表页只有系列名，型号清单是厂商全码。开启后先解候选 PDP 的权威型号再精确匹配。",
      "resolve_models": true,
      "resolve_limit": 40
    }
  },
  "product": {
    "_note": "型号由 sites/costco_common.py 在 adapter.parse_product 里补（页头 + 规格表）。",
    "title": {
      "selectors": [
        "h1",
        "h1[automation-id='productName']"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "jsonld": "brand.name",
      "transform": "brand"
    },
    "model": {
      "selectors": [
        "div[data-testid='Text_item-number']",
        "div[automation-id='modelNumber']"
      ],
      "regex": "Model\\s+([A-Za-z0-9][A-Za-z0-9._\\-+]{1,39})",
      "jsonld": "model",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    }
  },
  "price": {
    "_note": "★价格走 JSON-LD。Costco 用 MUI + 前端状态树，没有稳定价格类名。",
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "div.price span.value",
        "span[automation-id='productPriceOutput']"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "transform": "currency",
      "default": "USD"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        "div.your-price .value"
      ],
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "input[value='Add to Cart']",
        "button.add-to-cart-btn"
      ],
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "transform": "clean_text"
    }
  },
  "specs": [
    {
      "type": "kvlist",
      "container": "#ProductSpecifications tr, div.product-info-specs tr",
      "limit": 150
    }
  ],
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "selectors": [
        ".bv_avgRating_component_container",
        "[itemprop='ratingValue']"
      ],
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.ratingCount",
      "selectors": [
        ".bv_numReviews_text",
        "[itemprop='reviewCount']"
      ],
      "transform": "int"
    }
  },
  "reviews": {
    "_note": "★商品页 DOM 里没有评价明细，走 BazaarVoice 客户端接口。client/display_code 取自 https://apps.bazaarvoice.com/deployments/costco/native_review_form/production/en_US/ 的配置。",
    "source": "bazaarvoice_bfd",
    "bv": {
      "client": "Costco",
      "display_code": "2070_2_0",
      "site": "native_review_form",
      "locale": "en_US",
      "origin": "https://www.costco.com",
      "content_locale": "en_US",
      "page_size": 100,
      "max_pages": 3,
      "max_reviews": 100
    },
    "container": "ol.bv-content-list li.bv-content-item, div[itemprop='review']",
    "limit": 40,
    "fields": {
      "review_key": {
        "_note": "实际走 BV 接口，键取评价 Id（overseas/bv_reviews.py）；这里是 DOM 路径的兜底声明。",
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          ".bv-rating-stars-container .bv-off-screen",
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "h3.bv-content-title",
          ".review-title"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "div.bv-content-summary-body-text p",
          ".bv-content-summary"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          ".bv-author",
          ".bv-content-author-name"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "meta[itemprop='datePublished']",
          ".bv-content-datetime-stamp"
        ],
        "attr": "content",
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 60,
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "core_strip_suffix": [
        "pro",
        "max"
      ],
      "min_core_len": 4,
      "_size_tokens_note": "★US 标题同样是 '65\" Class - U65 Pro Series'，尺寸与系列被分隔词隔开。",
      "core_size_tokens": [
        "class",
        "inch",
        "in",
        "\"",
        "series"
      ]
    },
    "reject": {
      "_note": "★不要 reject 'protection plan' / 'bundle'：Costco US 把 Allstate 延保打包进商品标题，那些仍是真电视。",
      "title_contains_any": [
        "soundbar",
        "projector",
        "wall mount",
        "mount",
        "bracket",
        "stand",
        "case",
        "cover",
        "cable",
        "adapter",
        "screen protector"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "bv_api",
      "max_reviews": 100,
      "max_pages": 3
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "bv_exhausted_or_page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L3",
    "requires_browser": true,
    "detail_http": true,
    "interval_sec": 10.0,
    "retail_page_wait": "h1, script[type='application/ld+json']",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.95
  }
}
