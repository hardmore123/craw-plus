{
  "retail_spec_version": "0.1",
  "code": "max_gt",
  "name": "Max",
  "country": "Guatemala",
  "channel": "Max",
  "region": "gt",
  "base_url": "https://www.max.com.gt",
  "currency": "GTQ",
  "capabilities": [
    "price"
  ],
  "status": "candidate",
  "generated_by": "2026-09-23 实测: Next.js SSR + apigt.tienda.max.com.gt API, __NEXT_DATA__ + page.on(response) 截获分页",
  "anchor": "h1",
  "search": {
    "container": "a.relative",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "selectors": [
        "[class*='product-name']",
        "h3",
        "h2"
      ],
      "transform": "clean_text"
    },
    "url": {
      "self_attr": "href"
    },
    "_note": "__NEXT_DATA__.props.pageProps.productsList 含首屏12个SSR; 滚动触发apigt API page2-15; URL ?page=N 无效",
    "batch": {
      "max_candidates": 60,
      "keyword_template": "{brand} tv"
    },
    "search_url_template": "{base}/search?q={q}"
  },
  "product": {
    "title": {
      "selectors": [
        "h1"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[class*='brand']"
      ],
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9-]{4,20})\\b",
      "transform": "clean_text"
    },
    "size": {
      "regex": "(\\d{2,3})\\s*(?:\"|pulgadas|inch)",
      "transform": "size_inch"
    },
    "sku": {
      "jsonld": "sku",
      "transform": "clean_text"
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "[class*='price']",
        "[data-testid*='price']"
      ],
      "transform": "money"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        "[class*='regular-price']"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "transform": "currency",
      "default": "GTQ"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[itemprop='availability']",
        "button[class*='add-to-cart']:not([disabled])",
        "button[class*='buy']:not([disabled])",
        "[data-testid*='add-to-cart']:not([disabled])",
        "[class*='in-stock']",
        "[class*='disponible']"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "selectors": [
        "[class*='price']",
        "[itemprop='price']",
        "[data-price]"
      ],
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "none",
    "_note": "全站无评价系统; PDP 评价区占位div恒空; JSON-LD无aggregateRating; 0评价留空不造假",
    "container": "[class*='review']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']"
        ],
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title",
        "sku"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "core_strip_suffix": [
        "pro",
        "max"
      ],
      "min_core_len": 3
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "barra de sonido",
        "cable",
        "control remoto",
        "protector"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none"
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": true,
    "interval_sec": 6.0,
    "retail_page_wait": "h1",
    "_note": "Next.js SSR首屏__NEXT_DATA__+滚动触发apigt API分页; 直接调跨域后端API 403需浏览器context cookies",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.95
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "selectors": [
        "[itemprop='ratingValue']",
        "[class*='rating-value']",
        "[class*='avg-rating']"
      ],
      "attr": "content",
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "selectors": [
        "[itemprop='reviewCount']",
        "[class*='review-count']",
        "[class*='total-review']"
      ],
      "attr": "content",
      "transform": "int"
    }
  },
  "_autofix_search": {
    "date": "2026-10-10",
    "tool": "scripts/autofix_search.py",
    "evidence": {
      "links": 35,
      "verified_models": [
        "43UA8000:None",
        "43QD6QF:None"
      ]
    },
    "tried": [
      "{base}/search?q={q} [LG tv] 200 links=35"
    ]
  },
  "_price_suspect": {
    "date": "2026-10-10",
    "problems": [
      "价格低于GTQ电视下限 600：43UA8000=48, 43QD6QF=45"
    ],
    "note": "autofix 已修好搜索；价格规则抽到的不是电视价，待重新选价格规则"
  }
}
