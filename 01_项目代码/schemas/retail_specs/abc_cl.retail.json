{
  "retail_spec_version": "0.1",
  "code": "abc_cl",
  "name": "ABC",
  "country": "Chile",
  "channel": "ABC",
  "region": "cl",
  "base_url": "https://www.abc.cl",
  "currency": "CLP",
  "capabilities": [
    "price",
    "reviews"
  ],
  "status": "candidate",
  "anchor": "h1",
  "generated_by": "2026-09-24 实测: Demandware/Salesforce Commerce Cloud，评价走 PowerReviews display.powerreviews.com 直连 API（纯 HTTP，仅需 apikey+Origin）",
  "_design": {
    "平台": "Demandware / Salesforce Commerce Cloud（非 Magento）",
    "评价": "PowerReviews（ui.powerreviews.com + display.powerreviews.com API），纯 HTTP 直连，仅需 apikey + Origin 头",
    "config": {
      "api_key": "4e3e86e9-b81b-4319-a55f-93c47199f9db",
      "merchant_id": "968181234",
      "merchant_group_id": "362364466",
      "locale": "es_MX"
    },
    "page_id": "DB product.sku = PDP URL 末段 id = PowerReviews page_id（三者一致）",
    "pagination": "paging.next_page_url 翻页，page_size=10"
  },
  "search": {
    "container": "a.product-item-link, .product-tile",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 6000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 40,
      "fallback_per_model": true
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "meta[itemprop='brand']",
        ".product-brand"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9._\\-]{1,39})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[itemprop='sku']",
        "meta[itemprop='sku']"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        ".product-price .sales .value",
        ".price-sales"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']",
        "meta[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "default": "CLP"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        ".product-price .strike .value",
        ".price-list"
      ],
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[itemprop='availability']",
        ".availability-msg"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "powerreviews_api",
    "_note": "PowerReviews display.powerreviews.com 评价 API 直连：GET /m/968181234/l/all/product/{page_id}/reviews?apikey=4e3e86e9-...&page_locale=es_MX；DB sku 即 page_id；results[0].reviews[] 明细 + results[0].rollup 汇总(含 rating_histogram 1-5星)；翻页用 paging.next_page_url",
    "container": "[class*='review'], [itemprop='review']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']"
        ],
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "summary": {
    "avg_rating": {
      "selectors": [
        ".pr-snippet-rating-decimal"
      ],
      "transform": "rating"
    },
    "total_count": {
      "selectors": [
        ".pr-snippet-review-count"
      ],
      "transform": "int"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3,
      "core_strip_suffix": [
        "pro",
        "max"
      ]
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto",
        "remote",
        "bracket",
        "case",
        "cover",
        "soundbar",
        "barra de sonido",
        "parlante",
        "bocina",
        "proyector",
        "projector",
        "rack",
        "antena",
        "cleaner",
        "limpiador",
        "protector",
        "pantalla"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none",
      "max_reviews": 500,
      "max_pages": 20
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": true,
    "interval_sec": 6.0,
    "retail_page_wait": "h1",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.95
  }
}
