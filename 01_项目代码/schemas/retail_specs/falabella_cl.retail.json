{
  "retail_spec_version": "0.1",
  "code": "falabella_cl",
  "name": "Falabella",
  "country": "Chile",
  "channel": "Falabella",
  "region": "cl",
  "base_url": "https://www.falabella.com",
  "currency": "CLP",
  "capabilities": [
    "price",
    "reviews"
  ],
  "status": "candidate",
  "anchor": "h1",
  "generated_by": "2026-09-24 实测: Falabella Chile Next.js + BazaarVoice BFD 评价后端；PDP 被 Cloudflare 数据中心 IP 硬拦(403)，但搜索页纯 HTTP 200(内嵌 application/json props) + BV API 直连取评价",
  "_design": {
    "平台": "Falabella Chile Next.js + BazaarVoice BFD 评价后端（Cencosud/Tottus/Falabella 集团；CO/PE/AR 同架构）",
    "pdp_block": "★PDP /falabella-cl/product/<pid>/<slug> 被 Cloudflare 数据中心 IP 硬拦：浏览器 403 + Just a moment.../Un paso más 挑战页，40s 内 JS 挑战不解（Sharktech AS46844 美国数据中心被标记）；纯 HTTP PDP 同样 403；持久化 profile + human_like 也过不了",
    "search_ok": "搜索页 /falabella-cl/search?Ntt=<kw> 纯 HTTP 200（无 CF 挑战），返回 1.5-2.2MB HTML，内嵌 <script type=application/json> 含 Next.js props.pageProps.results[]（不是 __NEXT_DATA__！Falabella 把 Next 数据放进普通 application/json script）",
    "search_review_summary": "搜索 blob 每产品含 totalReviews + rating 字段（汇总信号）：productId/skuId/displayName/brand/url/prices/totalReviews/rating",
    "bv_deployment": "评价明细走 BV BFD API。部署 URL 从 _app-*.js 的 BAZAARVOICE_SCRIPT_URL 提取：CL=https://apps.bazaarvoice.com/deployments/Falabella/main_site/production/es_CL/bv.js（CO=Falabella-CO, PE=Falabella-PE, AR=Falabella-AR；CL 无后缀=client 名即 Falabella）",
    "bv_config": "client=Falabella, displayCode=1931, site=main_site, locale=es_CL, environment=production；Bv-Bfd-Token=1931,main_site,es_CL",
    "bv_api": "base=https://apps.bazaarvoice.com/bfd/v1/clients/Falabella/api-products/cv2/resources/data；reviews.json?apiVersion=5.4&filter=productid:<pid>&limit=100&offset=N&include=products&contentlocale=es_CL；summary display/0.2alpha/product/summary?productid=<pid>&contentType=reviews,questions&reviewDistribution=primaryRating,recommended&contentlocale=es_CL",
    "bv_auth": "请求头 Bv-Bfd-Token=1931,main_site,es_CL + Origin/Referer=falabella.com；缺则 400 invalid token",
    "bv_pid": "BV productId = 搜索 blob 的 productId（与 DB product.sku 不同；需从搜索结果取）",
    "currency": "CLP（评价本身无货币）"
  },
  "search": {
    "container": "script[type='application/json']",
    "_note": "Falabella 把 Next 数据放进普通 application/json script（非 __NEXT_DATA__），解析 props.pageProps.results[]",
    "sku": {
      "jsonld": "productId"
    },
    "title": {
      "jsonld": "displayName",
      "transform": "clean_text"
    },
    "url": {
      "jsonld": "url",
      "transform": "clean_text"
    },
    "wait_ms": 5000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 60,
      "fallback_per_model": true
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        "[data-testid='product-title']"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "jsonld": "brand",
      "selectors": [
        "[data-testid='brand-name']"
      ],
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9._\\-]{1,39})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "jsonld": "sku",
      "selectors": [
        "[data-testid='product-id']"
      ],
      "transform": "clean_text"
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "[data-testid='price']",
        ".prices-0"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "default": "CLP"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        "[data-testid='list-price']",
        ".prices-1"
      ],
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[data-testid='stock']",
        ".stock-status"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "bazaarvoice_bfd",
    "bv": {
      "client": "Falabella",
      "display_code": "1931",
      "site": "main_site",
      "locale": "es_CL",
      "origin": "https://www.falabella.com",
      "content_locale": "es_CL",
      "page_size": 100,
      "max_pages": 20,
      "max_reviews": 1000
    },
    "_note": "★PDP 被 Cloudflare 403 硬拦，评价走 BV BFD API 直连。BV productId = 搜索 blob productId（非 DB sku）。reviews.json 分页 offset 递增；summary display/0.2alpha/product/summary 取 numReviews/primaryRating.distribution/average。请求头 Bv-Bfd-Token + Origin/Referer 必带",
    "container": "[class*='review'], [itemprop='review']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']"
        ],
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "selectors": [
        ".bv_avgRating_component_container"
      ],
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "selectors": [
        ".bv_numReviews_text"
      ],
      "transform": "int"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 60,
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3,
      "core_strip_suffix": [
        "pro",
        "max"
      ]
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto",
        "remote",
        "bracket",
        "case",
        "cover",
        "soundbar",
        "barra de sonido",
        "parlante",
        "bocina",
        "proyector",
        "projector",
        "rack",
        "antena",
        "cleaner",
        "limpiador",
        "protector",
        "pantalla"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "bv_api",
      "max_reviews": 1000,
      "max_pages": 20
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "bv_exhausted_or_page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": true,
    "detail_http": true,
    "interval_sec": 6.0,
    "retail_page_wait": "h1",
    "_note": "★PDP 被 CF 403 硬拦需智利住宅 IP；搜索页纯 HTTP 200 + BV API 直连可取价+评价",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.85,
    "price_fill_rate_min": 0.9
  }
}
