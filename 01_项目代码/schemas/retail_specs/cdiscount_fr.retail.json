{
  "retail_spec_version": "0.1",
  "code": "cdiscount_fr",
  "name": "Cdiscount",
  "country": "France",
  "channel": "Cdiscount",
  "region": "FR",
  "base_url": "https://www.cdiscount.com",
  "currency": "EUR",
  "capabilities": [
    "price",
    "reviews"
  ],
  "generated_by": "_fr_sites_probe 实测探测 2026-09-25",
  "status": "candidate",
  "anchor": "h1",
  "search": {
    "container": "a[href*='/f-']",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 6000,
    "scroll_passes": 3,
    "batch": {
      "keyword_template": "{brand} tv",
      "threshold": 40,
      "force": true,
      "fallback_per_model": false,
      "max_candidates": 60,
      "max_search_failures": 2,
      "min_candidates": 5,
      "retries": 3
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "meta[itemprop='brand']",
        "[data-testid*='brand']"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "selectors": [
        "[itemprop='model']",
        "[data-testid*='model']"
      ],
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[itemprop='sku']",
        "meta[itemprop='sku']"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "[data-testid*='price']",
        "[class*='price']"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "default": "EUR"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[itemprop='availability']"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "transform": "clean_text"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        "[class*='list-price']",
        "[class*='old-price']",
        "[class*='was-price']",
        "[class*='original-price']",
        "[class*='strike']",
        "s",
        "del"
      ],
      "transform": "money"
    }
  },
  "specs": [],
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "selectors": [
        "[itemprop='ratingValue']"
      ],
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "selectors": [
        "[itemprop='reviewCount']"
      ],
      "transform": "int"
    }
  },
  "reviews": {
    "_note": "2026-09-25 _partial_reviews_fix: PDP HTTP 403 'Accès bloqué' (WAF, 当前出口 IP 被拦); HTTP 200 时仅 14KB SPA 壳无 SSR 评价/aggregateRating (jsonld Product node 缺失)。需法国 IP + 浏览器渲染确认评价基础设施。DB 0 review 确认(全库无该站 review)。source 保留 jsonld (被拦≠无评价)。",
    "source": "jsonld",
    "container": "[itemprop='review'], [class*='review'], [data-testid*='review']",
    "limit": 40,
    "jsonld": {
      "product_type": "Product",
      "aggregateRating": "aggregateRating",
      "review_array": "review",
      "field_map": {
        "review_key": "datePublished|author.name",
        "rating": "reviewRating.ratingValue",
        "title": "name",
        "body": "description",
        "author": "author.name",
        "review_date": "datePublished"
      }
    },
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[itemprop='name']",
          "[class*='review-title']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']"
        ],
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 60,
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "core_strip_suffix": [
        "pro",
        "max"
      ],
      "min_core_len": 3,
      "core_size_tokens": [
        "class",
        "inch",
        "in",
        "\"",
        "series",
        "pouces"
      ]
    },
    "reject": {
      "title_contains_any": [
        "soundbar",
        "projector",
        "wall mount",
        "mount",
        "bracket",
        "stand",
        "case",
        "cover",
        "cable",
        "adapter",
        "screen protector",
        "barre de son",
        "projecteur",
        "support mural",
        "cache"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none",
      "max_reviews": 1000,
      "max_pages": 20
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": true,
    "detail_http": false,
    "interval_sec": 6.0,
    "retail_page_wait": "h1, script[type='application/ld+json']",
    "nav_timeout_ms": 30000,
    "max_retries": 3
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.9
  },
  "_cdiscount_note": "★搜索页 JSON-LD 是类目级 AggregateOffer（非单商品），产品靠 DOM 提取：a[href*='/f-'] 锚文本是标题、SKU 从 URL /f-<cat>-<id>.html 取 <id>、价格在 [class*='price'] 文本块（如 '599,00 €\\n433,74 €'）。PDP 是服务端渲染，详情页可走 JSON-LD offers.price。★★评价探测（2026-09-25, _cdiscount_fr_probe2）：PDP JSON-LD @type=Product 内嵌 aggregateRating（ratingValue+ratingCount）+ review 数组（name=标题/description=正文/author.name/datePublished/reviewRating.ratingValue），是权威评价来源。BV 非 真 挂件（无 data-bv-show/bvapi.js，仅文本偶现 'bazaarvoice' 字样，非集成）；VTEX/第三方 无。reviews.source=jsonld，首屏评价 2~5 条 + summary 全量 ratingCount；无 JSON-LD 评价的产品留空不造假。stealth(_STEALTH_JS)+human_like=True 实测 PDP HTTP 200 全部可达。"
}
