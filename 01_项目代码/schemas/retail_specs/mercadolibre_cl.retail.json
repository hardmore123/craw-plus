{
  "retail_spec_version": "0.1",
  "code": "mercadolibre_cl",
  "name": "Mercado Libre CL",
  "country": "Chile",
  "channel": "Mercado Libre",
  "region": "cl",
  "base_url": "https://www.mercadolibre.cl",
  "currency": "CLP",
  "anchor": "h1, script[type='application/ld+json']",
  "shops": {
    "mode": "single_shop"
  },
  "_isomorphic": {
    "brand": "mercado",
    "reuse": "mercadolibre 各国同构（ML 平台前端统一，L2）"
  },
  "capabilities": [
    "price"
  ],
  "generated_by": "_gen_retail10.py 2026-09-26",
  "status": "blocked",
  "_blocked": {
    "http_status": -1,
    "block_reason": "http_-1：非 200",
    "note": "需住宅IP或代理切换；可达后补全 search/price/match 段"
  },
  "price": {
    "currency": "CLP",
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "[data-price]",
        ".price",
        "[class*='price']"
      ],
      "transform": "money"
    },
    "raw_text": {
      "selectors": [
        "[class*='price']",
        ".price"
      ],
      "jsonld": "offers.price",
      "transform": "clean_text"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        ".ui-pdp-price--old .andes-money-amount__fraction"
      ],
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        ".ui-pdp-buybox__quantity",
        "[itemprop='availability']"
      ],
      "attr": "content",
      "transform": "in_stock"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "verify": {
      "require_model_in": [
        "title"
      ]
    },
    "on_no_match": "skip"
  },
  "search": {
    "container": "a.ui-search-link, .ui-search-item",
    "sku": {
      "self_attr": "href",
      "_note": "ML item id (MLC123456789)"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 5000,
    "batch": {
      "keyword_template": "{brand} {model} tv",
      "max_candidates": 40,
      "fallback_per_model": true
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1.ui-pdp-title",
        "h1"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[class*='ui-pdp-brand']",
        "[itemprop='brand']"
      ],
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9._\\-]{1,39})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[itemprop='sku']",
        ".ui-pdp-id"
      ],
      "transform": "clean_text",
      "_note": "MLC item id"
    }
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "selectors": [
        ".ui-review-stars-summary"
      ],
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "selectors": [
        ".ui-review-capability__comments"
      ],
      "transform": "int"
    }
  },
  "reviews": {
    "source": "none",
    "container": "[class*='review'], [itemprop='review']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']"
        ],
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  }
}
