{
  "retail_spec_version": "0.1",
  "code": "amazon_mx",
  "name": "Amazon",
  "country": "Mexico",
  "channel": "Amazon",
  "region": "mx",
  "base_url": "https://www.amazon.com.mx",
  "currency": "MXN",
  "capabilities": [
    "price",
    "reviews"
  ],
  "generated_by": "反抽象: sites/amazon_mx/adapter.py + schema.json",
  "status": "candidate",
  "anchor": "#productTitle",
  "search": {
    "container": "a[href*='/dp/']",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "selectors": [
        "h2 span:not([class])",
        "a[class*='s-line-clamp']",
        "span.a-size-medium",
        "h2 span",
        "[data-cy='title-recipe'] span"
      ],
      "transform": "clean_text"
    },
    "url": {
      "self_attr": "href"
    },
    "batch": {
      "prefer_pool": true,
      "search_pages": 1,
      "max_candidates": 60,
      "threshold": 20,
      "fallback_per_model": true,
      "retries": 1,
      "_note": "P1: 池优先（省逐型号搜索）+ 池内未命中回退逐型号搜索（保覆盖率）。若要极致提速可设 fallback_per_model=false，但会丢覆盖率。",
      "_measurement_2026_09_20": {
        "US 1页": "池 17 候选，命中 12/179 = 6.7%",
        "US 8页": "池 140 候选，命中 34/179 = 19.0%",
        "CA 8页": "池 304 候选，命中 31/140 = 22.1%",
        "结论": "Amazon 品牌搜索受相关性排序限制，扩页收益极低（8页也只覆盖~20%型号）。逐型号精确搜索不可省 —— 它是覆盖率的主要来源。故 search_pages=1（复用首屏免去一次重复搜索），其余型号走回退逐型号搜索。"
      }
    }
  },
  "product": {
    "title": {
      "selectors": [
        "#productTitle",
        "#title span"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "#bylineInfo",
        "a#bylineInfo",
        "#brand",
        "#detailBullets_feature_div li:has-text('Marca')"
      ],
      "transform": "brand"
    },
    "model": {
      "kv": {
        "container": "#detailBullets_feature_div li, #productDetails_techSpec_section_1 tr, #productDetails_detailBullets_sections1 tr",
        "key_contains": "número de modelo",
        "value": "td"
      },
      "transform": "clean_text"
    },
    "category": {
      "selectors": [
        "#wayfinding-breadcrumbs_feature_div ul li:last-child a",
        "#nav-subnav a.nav-b"
      ],
      "transform": "clean_text"
    },
    "size": {
      "_note": "尺寸：优先变体选择项，其次规格表里的 Tamaño de la pantalla",
      "kv": {
        "container": "#productDetails_techSpec_section_1 tr, #detailBullets_feature_div li",
        "key_contains": "tamaño de la pantalla",
        "value": "td"
      },
      "selectors": [
        "#inline-twister-expanded-dimension-text-size_name",
        "#variation_size_name .selection"
      ],
      "transform": "size_inch"
    }
  },
  "price": {
    "price": {
      "selectors": [
        "#corePrice_feature_div span.a-price span.a-offscreen",
        "#corePriceDisplay_desktop_feature_div span.a-price span.a-offscreen",
        "span.a-price span.a-offscreen",
        "#priceblock_ourprice",
        "#priceblock_dealprice",
        "[data-a-color='price'] span.a-offscreen"
      ],
      "transform": "money"
    },
    "currency": {
      "selectors": [
        "#corePrice_feature_div span.a-price span.a-offscreen",
        "span.a-price span.a-offscreen",
        "#priceblock_ourprice"
      ],
      "transform": "currency_mx",
      "default": "MXN"
    },
    "list_price": {
      "selectors": [
        "span.a-price.a-text-price span.a-offscreen",
        "#listPrice",
        "#priceblock_listprice"
      ],
      "transform": "money"
    },
    "in_stock": {
      "selectors": [
        "#availability span",
        "#availability",
        "#add-to-cart-button"
      ],
      "transform": "in_stock"
    },
    "raw_text": {
      "selectors": [
        "#corePrice_feature_div span.a-price span.a-offscreen",
        "span.a-price span.a-offscreen"
      ],
      "transform": "clean_text"
    }
  },
  "specs": [
    {
      "type": "table",
      "container": "#productDetails_techSpec_section_1 tr, #productDetails_techSpec_section_2 tr, #productDetails_detailBullets_sections1 tr",
      "key": "th",
      "value": "td",
      "limit": 120
    },
    {
      "type": "kvlist",
      "container": "#detailBullets_feature_div li",
      "limit": 120,
      "skip_keys": [
        "opiniones de los clientes",
        "clasificación en los más vendidos",
        "producto en amazon desde"
      ]
    }
  ],
  "summary": {
    "avg_rating": {
      "selectors": [
        "#acrPopover",
        "span[data-hook='rating-out-of-text']",
        "#averageCustomerReviews .a-icon-alt"
      ],
      "attr": "title",
      "transform": "rating"
    },
    "total_count": {
      "selectors": [
        "#acrCustomerReviewText",
        "[data-hook='total-review-count']"
      ],
      "transform": "int"
    }
  },
  "reviews": {
    "container": "[data-hook='review'], div[id][data-hook='review']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[data-hook='review-star-rating'] .a-icon-alt",
          "[data-hook='cmps-review-star-rating'] .a-icon-alt",
          "i[data-hook='review-star-rating']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[data-hook='reviewTitle']",
          "[data-hook='review-title'] span:not([class])",
          "[data-hook='review-title'] span",
          "[data-hook='review-title']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[data-hook='reviewText'] span",
          "[data-hook='reviewText']",
          "[data-hook='reviewTextContainer'] span",
          "[data-hook='review-body'] span",
          "[data-hook='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          ".a-profile-name"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[data-hook='review-date']"
        ],
        "transform": "clean_text"
      },
      "verified": {
        "selectors": [
          "[data-hook='avp-badge']"
        ],
        "transform": "bool_present"
      },
      "helpful_count": {
        "selectors": [
          "[data-hook='helpful-vote-statement']"
        ],
        "transform": "int"
      },
      "review_url": {
        "selectors": [
          "a:has(h5[data-hook='reviewTitle'])",
          "a[data-hook='review-title']",
          "h5[data-hook='reviewTitle'] a",
          "a.a-link-normal.review-title-content"
        ],
        "attr": "href"
      }
    },
    "media": {
      "images": {
        "selector": "img[data-hook='review-image-tile'], .review-image-tile img, [data-hook='review-image-tile-section'] img",
        "attr": "src",
        "include": [
          "media-amazon.com/images/I/"
        ],
        "exclude": [
          "avatars-global",
          "grey-pixel"
        ],
        "hires": [
          "\\._[A-Z]{2}[0-9]+_",
          "._SL1600_"
        ],
        "limit": 30
      },
      "videos": {
        "selector": "video[data-hook='review-video'] source, [data-hook='review-video'] video, video.review-video source",
        "attr": "src",
        "exclude": [],
        "limit": 10
      }
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "core_strip_suffix": [
        "pro",
        "max"
      ],
      "min_core_len": 3,
      "size_split_match": true
    },
    "reject": {
      "title_contains_any": [
        "case",
        "cover",
        "wall mount",
        "stand",
        "screen",
        "bracket",
        "protector",
        "cable",
        "adapter",
        "remote",
        "control",
        " controller",
        "mount",
        "screw",
        "charger",
        "antenna",
        "cleaner",
        "replacement",
        "compatible",
        "for hisense",
        "fit for",
        "soporte",
        "base para"
      ],
      "url_contains_any": [],
      "_expanded_2026_09_20": "实测：逐型号回退路径原先未做 reject 校验，导致 Remote Control / Wall Mount Bracket / Screws 等配件作为电视入库；已补 reject + 扩充词表（remote/control/mount/bracket/screw/replacement 等）。"
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "_verified_2026_09_20": {
        "结论": "filterByStar 部分生效，但站点评价总量本身极少，收益有限",
        "实测证据": {
          "B0GQVLQT5F": "总评分(12) → 首屏 5 条；five_star→4 条、positive→5 条、critical→0 条；并集仍 5 条",
          "B0GQSTJXWK": "总评分(4) → 首屏 2 条；各 combo 1~2 条；并集 2 条",
          "判断": "不同 filterByStar 确实返回不同屏（说明机制有效），但基数太小，并集≈首屏",
          "无分页控件": "两型号 li.a-last 均为 0"
        },
        "价值定位": "MX 的网评价值在'如实拿到全部可见评价'，而非追求 50 条上限；组合扫描保留即可",
        "价格链路": "正常。实测 PDP 取到 2499.0 MXN（两型号）",
        "登录": {
          "方式": "python -m overseas.cli login --site amazon_mx --profile --url https://www.amazon.com.mx/",
          "凭证 cookie": "at-acbmx / sess-at-acbmx / x-acbmx（国别后缀 acbmx）",
          "登录过程": "实测出现 OTP/验证挑战（/ap/cvf/request?arb=），完成验证后签发凭证",
          "权威校验": "/gp/css/order-history 不跳 /ap/signin ⇒ 真登录（已实测通过）"
        },
        "注意": "评价页可正常访问（Amazon.com.mx:Opiniones de clientes），不再跳登录墙"
      },
      "type": "filter_sweep",
      "url_template": "{base}/product-reviews/{sku}/?reviewerType=all_reviews&sortBy={sortBy}&filterByStar={filterByStar}&pageNumber=1",
      "combos": [
        {
          "sortBy": "recent",
          "filterByStar": ""
        },
        {
          "sortBy": "helpful",
          "filterByStar": ""
        },
        {
          "sortBy": "recent",
          "filterByStar": "positive"
        },
        {
          "sortBy": "recent",
          "filterByStar": "critical"
        },
        {
          "sortBy": "recent",
          "filterByStar": "five_star"
        },
        {
          "sortBy": "recent",
          "filterByStar": "four_star"
        },
        {
          "sortBy": "recent",
          "filterByStar": "three_star"
        },
        {
          "sortBy": "recent",
          "filterByStar": "two_star"
        },
        {
          "sortBy": "recent",
          "filterByStar": "one_star"
        },
        {
          "sortBy": "helpful",
          "filterByStar": "positive"
        },
        {
          "sortBy": "helpful",
          "filterByStar": "critical"
        }
      ],
      "no_new_combos_cap": 4,
      "max_reviews": 50,
      "max_pages": 12
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L3",
    "requires_browser": true,
    "interval_sec": 8.0,
    "retail_page_wait": "#productTitle, #dp, .a-price",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.95
  },
  "_price_region_fix_2026_09_20": {
    "修复": "同 amazon_ca/us —— 改用共用 parse_amazon_product（本 adapter 原先无 parse_product，走 schema 路径会漏掉价格区校验）",
    "原因": "无 buybox 主价时配件/推荐位价格会被误当电视价"
  }
}
