{
  "retail_spec_version": "0.1",
  "code": "flanco_ro",
  "name": "Flanco",
  "country": "Romania",
  "channel": "Flanco",
  "region": "ro",
  "base_url": "https://www.flanco.ro",
  "currency": "RON",
  "capabilities": [
    "price"
  ],
  "generated_by": "balkan_baltic_probe/2026-09-25",
  "status": "blocked",
  "anchor": "h1, script[type='application/ld+json']",
  "shops": {
    "mode": "single_shop"
  },
  "_blocked": {
    "http_status": 403,
    "block_reason": "http_403",
    "note": "需住宅IP或代理切换"
  },
  "search": {
    "container": "[class*='product'], a[href*='/product/'], a[href*='/pd/']",
    "wait_ms": 5000,
    "scroll_passes": 3,
    "batch": {
      "max_candidates": 60,
      "max_pages": 20,
      "threshold": 10
    }
  },
  "price": {
    "selectors": [
      "[class*='price']",
      "[data-testid*='price']",
      ".price",
      ".product-price"
    ],
    "transform": "money",
    "jsonld": false,
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "[data-testid*='price']",
        "[itemprop='price']",
        "meta[itemprop='price']",
        "[class*='price']:not([class*='old'])",
        ".price:not(.old-price)",
        ".product-price"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']",
        "meta[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "default": "RON"
    },
    "list_price": {
      "selectors": [
        "[class*='old-price']",
        "[class*='original-price']",
        "[class*='was-price']",
        "s",
        "del"
      ],
      "transform": "money"
    },
    "raw_text": {
      "selectors": [
        "[data-testid*='price']",
        "[itemprop='price']",
        ".product-price"
      ],
      "transform": "clean_text"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "on_no_match": "skip",
    "verify": {
      "require_model_in": [
        "title",
        "url",
        "sku"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "min_core_len": 3
    },
    "reject": {
      "title_contains_any": [
        "case",
        "cover",
        "wall mount",
        "stand",
        "bracket",
        "protector",
        "cable",
        "adapter",
        "remote",
        "control",
        "mount",
        "screw",
        "charger",
        "soundbar",
        "speaker"
      ]
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        "#productTitle",
        "[itemprop='name']"
      ],
      "transform": "clean_text",
      "jsonld": "name"
    },
    "brand": {
      "selectors": [
        "[itemprop='brand']",
        "[data-brand]",
        "[class*='brand']",
        "[itemprop='manufacturer']"
      ],
      "attr": "content",
      "transform": "brand",
      "jsonld": "brand.name"
    },
    "model": {
      "selectors": [
        "[itemprop='model']",
        "[itemprop='mpn']",
        "[data-testid*='model']",
        "[data-model]"
      ],
      "attr": "content",
      "jsonld": "mpn",
      "regex": "\\b([A-Z0-9][A-Z0-9._-]{3,25})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "regex": "(\\d{2,3})\\s*(?:\"|inch|in|pulgada|Zoll|pollici|pouces|インチ|型)",
      "transform": "size_inch"
    },
    "category": {
      "selectors": [
        "[itemprop='category']",
        ".breadcrumb li:last-child",
        ".breadcrumbs li:last-child"
      ],
      "transform": "clean_text"
    }
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "selectors": [
        "[itemprop='ratingValue']",
        "[class*='rating-value']",
        "[class*='avg-rating']"
      ],
      "attr": "content",
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "selectors": [
        "[itemprop='reviewCount']",
        "[class*='review-count']",
        "[class*='total-review']"
      ],
      "attr": "content",
      "transform": "int"
    }
  },
  "reviews": {
    "container": "[itemprop='review'], [class*='review-item'], [data-testid*='review'], [data-hook='review'], [class*='review-card']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id",
        "self_attr_alt": "data-review-id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']",
          "[class*='rating']",
          "[class*='star']",
          "[data-hook*='rating']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']",
          "[itemprop='name']",
          "[data-hook*='reviewTitle']",
          "h3",
          "h4"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']",
          "[class*='review-text']",
          "[data-hook*='reviewText']",
          "[data-hook*='review-body']",
          "p"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']",
          "[class*='author']",
          "[class*='reviewer']",
          ".a-profile-name"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']",
          "time",
          "[class*='review-date']",
          "[data-hook*='review-date']"
        ],
        "attr": "datetime",
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "limit": 5
      }
    }
  }
}
