{
  "retail_spec_version": "0.1",
  "code": "samsung_bo",
  "name": "Samsung（玻利维亚）",
  "country": "Bolivia",
  "channel": "Samsung 官网",
  "region": "bo",
  "base_url": "https://samsung.com.bo",
  "currency": "BOB",
  "capabilities": [
    "price"
  ],
  "generated_by": "SA4 任务实测生成 (2026-09-27)：BrowserFetcher(human_like=True) 200 OK (偶超时需≥45s)；Samsung AEM 站；分类页 /tvs 列 product-card-v2 (12卡)；PDP /tvs/<cat>/<slug>-<modelcode> (如 un75au8200gxzs)，JSON-LD Product 含 name+sku 无 price；★where-to-buy 展示型站无在线直接售价 (data-price 是 Angular 模板占位)，price 选择器配齐抓不到即留空（缺价>错价）；DB site 已存在(L3_STRONG, 15产品)，本任务只补 spec/adapter",
  "status": "candidate",
  "anchor": "h1, .product-card-v2",
  "search": {
    "container": "a[href*='/tvs/'][href*='inch'], a[href*='/tvs/'][href*='gxzs'], .product-card-v2",
    "sku": {
      "selectors": [
        "a[href*='/tvs/'][href*='inch']"
      ],
      "attr": "href"
    },
    "title": {
      "selectors": [
        ".product-card-v2__name",
        ".pd03-product-card__name",
        "h2",
        "h3"
      ],
      "transform": "clean_text"
    },
    "url": {
      "selectors": [
        "a[href*='/tvs/'][href*='inch']"
      ],
      "attr": "href"
    },
    "wait_ms": 6000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 60,
      "fallback_per_model": true
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        ".product-title",
        ".pd03-product-card__name"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "meta[itemprop='brand']",
        "[data-brand]"
      ],
      "attr": "content",
      "transform": "brand",
      "jsonld": "brand.name"
    },
    "model": {
      "selectors": [
        "meta[itemprop='model']",
        "[data-modelcode]",
        "[itemprop='mpn']"
      ],
      "attr": "content",
      "transform": "clean_text",
      "jsonld": "sku"
    },
    "size": {
      "selectors": [
        "h1",
        ".product-title"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "meta[itemprop='sku']",
        "[data-modelcode]"
      ],
      "attr": "content",
      "transform": "clean_text",
      "jsonld": "sku"
    }
  },
  "price": {
    "price": {
      "selectors": [
        ".result-price",
        "[data-price]",
        ".where-to-buy__price",
        ".product-price"
      ],
      "transform": "money",
      "jsonld": "offers.price"
    },
    "currency": {
      "selectors": [
        "meta[itemprop='priceCurrency']",
        "[data-currency]"
      ],
      "attr": "content",
      "transform": "currency",
      "jsonld": "offers.priceCurrency",
      "default": "BOB"
    },
    "list_price": {
      "selectors": [
        "del .price",
        ".original-price",
        "s"
      ],
      "transform": "money",
      "jsonld": "offers.highPrice"
    },
    "in_stock": {
      "selectors": [
        "[itemprop='availability']",
        ".where-to-buy__online"
      ],
      "attr": "content",
      "transform": "in_stock",
      "jsonld": "offers.availability"
    },
    "raw_text": {
      "selectors": [
        ".result-price",
        ".where-to-buy__price"
      ],
      "transform": "clean_text"
    }
  },
  "specs": [],
  "summary": {
    "avg_rating": {
      "selectors": [
        ".star-rating",
        "[itemprop='ratingValue']"
      ],
      "transform": "rating",
      "jsonld": "aggregateRating.ratingValue"
    },
    "total_count": {
      "selectors": [
        ".review-count",
        "[itemprop='reviewCount']"
      ],
      "transform": "int",
      "jsonld": "aggregateRating.reviewCount"
    }
  },
  "reviews": {
    "container": ".review, [itemprop='review'], .comment",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          ".star-rating",
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          ".review-title",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          ".review-body",
          "[itemprop='reviewBody']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          ".review-author",
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          ".review-date",
          "time",
          "[itemprop='datePublished']"
        ],
        "transform": "clean_date"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "core_strip_suffix": [
        "pro",
        "max"
      ],
      "min_core_len": 3
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto",
        "remote",
        "bracket",
        "case",
        "cover",
        "soundbar",
        "barra de sonido",
        "parlante",
        "bocina",
        "proyector",
        "rack",
        "antena"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none"
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L3",
    "requires_browser": true,
    "interval_sec": 7.0,
    "retail_page_wait": "h1, .product-card-v2",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.5
  }
}
