{
  "retail_spec_version": "0.1",
  "code": "alkostoplus_bo",
  "name": "Multicenter+",
  "country": "Bolivia",
  "channel": "Multicenter+",
  "region": "bo",
  "base_url": "https://alkostoplus.com",
  "currency": "BOB",
  "capabilities": [
    "price",
    "reviews"
  ],
  "status": "candidate",
  "anchor": "h1",
  "generated_by": "2026-09-25 实测(rv9重探): 自研 Next.js App Router + CMS（非 VTEX/Woo/Shopify/Magento），SSR 输出 RSC payload；站点只公开评价聚合(avg+total)，无单条评论明细 API",
  "_design": {
    "平台": "自研 Next.js App Router + CMS，SSR 输出 RSC payload（self.__next_f.push）",
    "评价": "★有聚合无明细：PDP Opiniones 区只渲染 <span class='font-medium text-fg'>4.9</span><span>(338)</span> 形式的聚合，无评论卡片/作者/日期。写 review_summary(avg+total)，review 表留空不造假",
    "聚合抽取": "纯 HTTP 取 PDP → rendered HTML 正则 <span class=\"font-medium text-fg\">(avg)</span><span>(<!-- -->(total)，比 RSC payload 更直接",
    "vtex_check": "/_v/public/graphql/v1 reviewsByProductId → HTTP 307 跳 /login 确认非 VTEX",
    "self_api": "/api/products/opiniones 仅 OPTIONS+PATCH（提交端点需登录，无 GET 公开读取接口）",
    "third_party": "无 BazaarVoice/Feefo/Yotpo/Trustpilot/Reviews.io/verificado.ai（全探测 401/404/400/403）",
    "product_id_mapping": "DB product.sku 是 URL slug(hisense-50-q6n)；真实 productId 是 CMS id(cms3och...)，但聚合抽取不依赖它",
    "currency": "BOB（评价本身无货币）"
  },
  "search": {
    "container": "a[href*='/tienda/producto/'], .product-card",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 6000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 40,
      "fallback_per_model": true
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        "[data-testid='product-name']"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[data-testid='brand']",
        ".brand-name"
      ],
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9._\\-]{1,39})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[data-testid='sku']",
        "[itemprop='sku']"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        ".product-price",
        "[data-testid='price']"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "default": "BOB"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        ".product-price--original",
        "[data-testid='list-price']"
      ],
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[itemprop='availability']",
        "[data-testid='stock']"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "aggregate_only",
    "_note": "★站点只公开评价聚合(avg+total)，无单条评论明细 API/挂件/DOM。写 review_summary(avg_rating+total_count)，review 表按红线留空不造假。聚合抽取正则：<span class=\"font-medium text-fg\">(\\d+\\.?\\d*)</span><span>\\((?:<!-- -->)?(\\d+)",
    "container": "[class*='opinion'], [class*='review']",
    "limit": 0,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']"
        ],
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "summary": {
    "_note": "聚合从 PDP rendered HTML 抽取：<span class=\"font-medium text-fg\">(avg)</span><span>(<!-- -->(total)。stars 留空（站点不提供分布）",
    "avg_rating": {
      "selectors": [
        "span.font-medium.text-fg"
      ],
      "transform": "rating"
    },
    "total_count": {
      "selectors": [
        "span.font-medium.text-fg + span"
      ],
      "transform": "int"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3,
      "core_strip_suffix": [
        "pro",
        "max"
      ]
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto",
        "remote",
        "bracket",
        "case",
        "cover",
        "soundbar",
        "barra de sonido",
        "parlante",
        "bocina",
        "proyector",
        "projector",
        "rack",
        "antena",
        "cleaner",
        "limpiador",
        "protector",
        "pantalla"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none"
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": false,
    "detail_http": true,
    "interval_sec": 6.0,
    "retail_page_wait": "h1",
    "_note": "RSC 是 SSR 静态文本，HttpFetcher 即可抽聚合，无需 BrowserFetcher",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.9
  }
}
