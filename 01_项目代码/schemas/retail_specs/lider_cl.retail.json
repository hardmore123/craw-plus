{
  "retail_spec_version": "0.1",
  "code": "lider_cl",
  "name": "Lider",
  "country": "Chile",
  "channel": "Lider",
  "region": "cl",
  "base_url": "https://www.lider.cl",
  "currency": "CLP",
  "capabilities": [
    "price",
    "reviews"
  ],
  "status": "candidate",
  "anchor": "h1",
  "generated_by": "2026-09-24 实测: Walmart Chile Next.js (tenant=CHILE_EA_GLASS, locale=es-CL)，浏览器被 PerimeterX /blocked 硬拦但 HTTP 直连 PDP 反可用，评价数据 SSR 内嵌在 __NEXT_DATA__",
  "_design": {
    "平台": "Walmart Chile Next.js (tenant=CHILE_EA_GLASS, locale=es-CL)",
    "pdp_ssr": "__NEXT_DATA__.props.pageProps.initialData.data 内嵌 product.usItemId + reviews 聚合 + customerReviews[]",
    "review_id": "reviews.customerReviews[].reviewId (站内稳定)",
    "summary_fields": "reviews.{totalReviewCount, roundedAverageOverallRating, ratingValue{1..5}Count}",
    "bot_wall": "★Playwright(headless/非headless/持久profile)一律被 PerimeterX /blocked 'Robot or human?' 拦截；同代理下 requests 直连 PDP 稳定 200",
    "rate_limit": "连续快速请求被边缘返回~14KB小响应(无__NEXT_DATA__)；串行+间隔>=6s 全 102 产品 0 失败",
    "gql_blocked": "/orchestra/graphql ReviewsById 评价分页查询返回通用400('Something went wrong')，疑似需前端token/白名单，直连不可用",
    "limits": "__NEXT_DATA__ 内嵌评价受 limitReviewsToShow 限制最多~10条；total>10 时只采首屏代表性评价，summary 按 totalReviewCount 全量记录，不造假",
    "currency": "CLP（$ 前缀，. 千分位；price 字段为 int）",
    "real_url": "正确分类在 www.lider.cl 首页导航 __NEXT_DATA__.bootstrapData.header.contentLayout 下，/browse/tecno/tv/66849718_44699651（带下划线分类ID路径）；任务给的 /tv-y-video/televisores 是 404+AWS WAF CAPTCHA"
  },
  "search": {
    "container": "script#__NEXT_DATA__",
    "_note": "Next.js SSR 已含 __NEXT_DATA__，产品在 props.pageProps.initialData.searchResult.itemStacks[].items[]（分类页）或 initialData.data（PDP）",
    "sku": {
      "jsonld": "usItemId"
    },
    "title": {
      "jsonld": "name",
      "transform": "clean_text"
    },
    "url": {
      "jsonld": "canonicalUrl",
      "transform": "clean_text"
    },
    "wait_ms": 4000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 60,
      "fallback_per_model": true
    }
  },
  "product": {
    "title": {
      "jsonld": "name",
      "selectors": [
        "h1"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "jsonld": "brand",
      "selectors": [
        "[data-testid='brand']"
      ],
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9._\\-]{1,39})\\b",
      "transform": "clean_text",
      "_note": "canonicalUrl 末段 slug 或标题正则"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "regex": "(\\d{2,3})\\s*(?:\\\"|inch|pulgadas|in\\b)",
      "transform": "size_inch"
    },
    "sku": {
      "jsonld": "usItemId",
      "selectors": [
        "[data-testid='item-id']"
      ],
      "transform": "clean_text"
    }
  },
  "price": {
    "price": {
      "jsonld": "price",
      "selectors": [
        "[data-testid='price']",
        ".price"
      ],
      "transform": "money",
      "_note": "price 字段为 CLP int，priceInfo.linePrice 兜底"
    },
    "currency": {
      "selectors": [
        "[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "default": "CLP"
    },
    "list_price": {
      "jsonld": "priceInfo.listPrice",
      "selectors": [
        "[data-testid='list-price']"
      ],
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "availabilityStatusV2",
      "selectors": [
        "[data-testid='stock']"
      ],
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "price",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "next_data_inline",
    "_note": "★HTTP 直连 PDP 解析 __NEXT_DATA__.props.pageProps.initialData.data.reviews.customerReviews[]（reviewId 为 review_key）；不用浏览器（浏览器被 PerimeterX 硬拦）。内嵌评价受 limitReviewsToShow 限制最多~10条，total>10 只采首屏代表性评价，summary 按 totalReviewCount 全量记录不造假。ratingValue{1..5}Count → review_summary.star{1..5}",
    "container": "[class*='review'], [itemprop='review']",
    "limit": 10,
    "fields": {
      "review_key": {
        "jsonld": "reviewId"
      },
      "rating": {
        "jsonld": "rating",
        "transform": "rating"
      },
      "title": {
        "jsonld": "title",
        "transform": "clean_text"
      },
      "body": {
        "jsonld": "reviewText",
        "transform": "clean_text"
      },
      "author": {
        "jsonld": "userNickname",
        "transform": "clean_text"
      },
      "review_date": {
        "jsonld": "submissionTime",
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "summary": {
    "_note": "reviews.ratingValue{1..5}Count → star{1..5}; roundedAverageOverallRating → avg_rating; totalReviewCount → total_count（全量记录）",
    "avg_rating": {
      "jsonld": "roundedAverageOverallRating",
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "totalReviewCount",
      "transform": "int"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 60,
    "verify": {
      "require_model_in": [
        "title",
        "url",
        "sku"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3,
      "core_strip_suffix": [
        "pro",
        "max"
      ]
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto",
        "remote",
        "bracket",
        "case",
        "cover",
        "soundbar",
        "barra de sonido",
        "parlante",
        "bocina",
        "proyector",
        "projector",
        "rack",
        "antena",
        "cleaner",
        "limpiador",
        "protector",
        "pantalla"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none",
      "_note": "GraphQL /orchestra/graphql 评价分页被网关 400 挡住(需前端token)，不可直连；只采首屏"
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": false,
    "detail_http": true,
    "interval_sec": 7.0,
    "retail_page_wait": "script#__NEXT_DATA__",
    "_note": "★反直觉：浏览器被 PerimeterX 硬拦但 HTTP 直连 PDP 反可用——评价数据 SSR 内嵌在 __NEXT_DATA__ 里，直接 requests+7s 限速即可。REQUEST_INTERVAL=7s 串行(同域名<6s会被软拦)",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.95,
    "reviews": "first-screen only (~10), total>10 noted unpaged"
  }
}
