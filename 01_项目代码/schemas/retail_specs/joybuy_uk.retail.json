{
  "retail_spec_version": "0.1",
  "code": "joybuy_uk",
  "name": "Joybuy",
  "country": "United Kingdom",
  "channel": "Joybuy",
  "region": "uk",
  "base_url": "https://www.joybuy.co.uk",
  "currency": "GBP",
  "capabilities": [
    "price"
  ],
  "generated_by": "uk_ru_probe/2026-09-26",
  "status": "blocked",
  "anchor": "body",
  "shops": {
    "mode": "single_shop"
  },
  "_blocked": {
    "http_status": 200,
    "block_reason": "not_logged_in",
    "probe_title": "Login to Your Account | Joybuy",
    "note": "探测 403/CF 或异常 → capabilities=[]，占位 spec + adapter 待线路解决后重探测。"
  },
  "search": {
    "container": "a[href*='/product/'], .product-card, .gl-item",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true,
      "transform": "clean_text"
    },
    "url": {
      "self_attr": "href"
    },
    "batch": {
      "max_candidates": 60
    }
  },
  "fetch": {
    "protection": "L3",
    "requires_browser": true,
    "interval_sec": 6.0
  },
  "price": {
    "currency": "GBP",
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "[data-price]",
        ".price",
        "[class*='price']"
      ]
    },
    "raw_text": {
      "selectors": [
        "[class*='price']",
        ".price"
      ]
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "verify": {
      "require_model_in": [
        "title"
      ]
    },
    "on_no_match": "skip"
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        "#productTitle",
        "[itemprop='name']"
      ],
      "transform": "clean_text",
      "jsonld": "name"
    },
    "brand": {
      "selectors": [
        "[itemprop='brand']",
        "[data-brand]",
        "[class*='brand']",
        "[itemprop='manufacturer']"
      ],
      "attr": "content",
      "transform": "brand",
      "jsonld": "brand.name"
    },
    "model": {
      "selectors": [
        "[itemprop='model']",
        "[itemprop='mpn']",
        "[data-testid*='model']",
        "[data-model]"
      ],
      "attr": "content",
      "jsonld": "mpn",
      "regex": "\\b([A-Z0-9][A-Z0-9._-]{3,25})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "regex": "(\\d{2,3})\\s*(?:\"|inch|in|pulgada|Zoll|pollici|pouces|インチ|型)",
      "transform": "size_inch"
    },
    "category": {
      "selectors": [
        "[itemprop='category']",
        ".breadcrumb li:last-child",
        ".breadcrumbs li:last-child"
      ],
      "transform": "clean_text"
    }
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "selectors": [
        "[itemprop='ratingValue']",
        "[class*='rating-value']",
        "[class*='avg-rating']"
      ],
      "attr": "content",
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "selectors": [
        "[itemprop='reviewCount']",
        "[class*='review-count']",
        "[class*='total-review']"
      ],
      "attr": "content",
      "transform": "int"
    }
  },
  "reviews": {
    "container": "[itemprop='review'], [class*='review-item'], [data-testid*='review'], [data-hook='review'], [class*='review-card']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id",
        "self_attr_alt": "data-review-id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']",
          "[class*='rating']",
          "[class*='star']",
          "[data-hook*='rating']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']",
          "[itemprop='name']",
          "[data-hook*='reviewTitle']",
          "h3",
          "h4"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']",
          "[class*='review-text']",
          "[data-hook*='reviewText']",
          "[data-hook*='review-body']",
          "p"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']",
          "[class*='author']",
          "[class*='reviewer']",
          ".a-profile-name"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']",
          "time",
          "[class*='review-date']",
          "[data-hook*='review-date']"
        ],
        "attr": "datetime",
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "limit": 5
      }
    }
  }
}
