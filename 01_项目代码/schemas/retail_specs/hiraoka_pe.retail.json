{
  "retail_spec_version": "0.1",
  "code": "hiraoka_pe",
  "name": "Hiraoka",
  "country": "Peru",
  "channel": "Hiraoka",
  "region": "pe",
  "base_url": "https://hiraoka.com.pe",
  "currency": "PEN",
  "capabilities": [
    "price"
  ],
  "status": "candidate",
  "anchor": "h1",
  "generated_by": "2026-09-24 实测: Magento 2 + Infracommerce 主题，PDP 内嵌 JSON review_html 字段 20/20 全空=无评价；无聚合/明细/第三方挂件/JSON-LD",
  "_design": {
    "平台": "Magento 2 + Infracommerce 主题（baseCurrencyCode=PEN, storeViewCode=es_PE）",
    "review_backend": "无——Infracommerce 主题评论模块对 20 产品全部返回空",
    "pdp_review_html": "★PDP 内嵌产品 JSON 的 'review_html' 字段，20/20 产品全空字符串 ''（Infracommerce 评论模块渲染结果为空=该产品无评价HTML）。空字符串=无评价HTML产出",
    "magento_listajax": "标准 Magento 评论接口 /review/product/listAjax/id/<mage_id>/ 返 404（Infracommerce 不用 Magento 原生评论模块）",
    "no_widget": "PDP 无 BV/Yotpo/Trustpilot/Judge.me/Reviews.io 第三方评价挂件（全页 0 匹配）",
    "no_jsonld": "无 application/ld+json aggregateRating/reviewBody 块（0 匹配）",
    "currency": "PEN（秘鲁索尔）"
  },
  "search": {
    "container": "li.product-item, .product-item-link",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 6000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 40,
      "fallback_per_model": true
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        ".page-title"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[itemprop='brand']",
        "meta[itemprop='brand']"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9._\\-]{1,39})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[itemprop='sku']",
        "meta[itemprop='sku']"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        ".price",
        "[data-price-amount]"
      ],
      "attr": "content",
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']",
        "meta[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "default": "PEN"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        ".old-price",
        "[data-price-amount]"
      ],
      "attr": "content",
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[itemprop='availability']",
        ".stock"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "none",
    "_note": "★Infracommerce 评论模块对该批产品无评价产出：review_html='' 且无摘要/JSON-LD/挂件 → 20 产品 0 网评属实为真实状态，review/review_summary 表按红线留空不造假（不写 summary，无聚合数据可记）",
    "container": "[class*='review'], [itemprop='review']",
    "limit": 0,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']"
        ],
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[class*='review-photo'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "exclude": [],
        "limit": 5
      }
    }
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "transform": "int"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3,
      "core_strip_suffix": [
        "pro",
        "max"
      ]
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto",
        "remote",
        "bracket",
        "case",
        "cover",
        "soundbar",
        "barra de sonido",
        "parlante",
        "bocina",
        "proyector",
        "projector",
        "rack",
        "antena",
        "cleaner",
        "limpiador",
        "protector",
        "pantalla"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  },
  "paginate": {
    "reviews": {
      "type": "none"
    }
  },
  "incremental": {
    "key_field": "review_key",
    "stop_when": "page_all_known"
  },
  "shops": {
    "mode": "single_shop"
  },
  "export": {
    "size_from": "title"
  },
  "fetch": {
    "protection": "L2",
    "requires_browser": true,
    "detail_http": true,
    "interval_sec": 6.0,
    "retail_page_wait": "h1",
    "_note": "HTTP 直抓 PDP 解析内嵌 JSON 的 review_html 字段即可判无评价，无需浏览器渲染",
    "max_retries": 3,
    "nav_timeout_ms": 30000
  },
  "expected": {
    "match_rate_min": 0.85,
    "price_fill_rate_min": 0.9,
    "reviews": "no infrastructure, leave empty"
  }
}
