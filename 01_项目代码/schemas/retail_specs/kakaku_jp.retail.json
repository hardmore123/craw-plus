{
  "retail_spec_version": "0.1",
  "code": "kakaku_jp",
  "name": "価格.com（日本，聚合站）",
  "country": "Japan",
  "channel": "Kakaku.com",
  "region": "jp",
  "base_url": "https://kakaku.com",
  "currency": "JPY",
  "capabilities": [
    "price"
  ],
  "generated_by": "反抽象: sites/kakaku_jp/adapter.py（SHOP_COLUMNS / shop_prices / map_shop_columns）",
  "status": "candidate",
  "_comment": "店铺列与现状 SHOP_COLUMN_NAMES 完全一致（导出回归基线）。评价抓取在 kakaku 仍由 crawl_kakaku_reviews.py 处理，本 spec 暂只声明 price 线（capabilities 不含 reviews）。",
  "anchor": "h1",
  "search": {
    "container": ".p-product_name a, a[href*='/item/']",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "selectors": [
        ".p-product_name"
      ],
      "transform": "clean_text"
    },
    "url": {
      "self_attr": "href"
    },
    "batch": {
      "search_pages": 1,
      "max_candidates": 60,
      "retries": 1,
      "_note": "安全机制：search_pages 为搜索页翻页上限（max_search_pages 等价），防搜索死循环。"
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1"
      ],
      "transform": "clean_text"
    },
    "model": {
      "kv": {
        "container": "#spec tr",
        "key_contains": "型番",
        "value": "td"
      },
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[itemprop='brand']",
        "[class*='brand']",
        "[class*='maker']"
      ],
      "attr": "content",
      "transform": "brand",
      "jsonld": "brand.name"
    }
  },
  "price": {
    "price": {
      "selectors": [
        ".p-lowestPrice"
      ],
      "transform": "money"
    },
    "currency": {
      "selectors": [
        ".p-lowestPrice"
      ],
      "transform": "currency",
      "default": "JPY"
    },
    "list_price": {
      "selectors": [
        "[class*='list-price']",
        "[class*='old-price']",
        "[class*='was-price']",
        "[class*='original-price']",
        "[class*='strike']",
        "s",
        "del"
      ],
      "transform": "money"
    },
    "in_stock": {
      "selectors": [
        "[itemprop='availability']",
        "button[class*='add-to-cart']:not([disabled])",
        "button[class*='buy']:not([disabled])",
        "[data-testid*='add-to-cart']:not([disabled])",
        "[class*='in-stock']",
        "[class*='disponible']"
      ],
      "transform": "in_stock"
    },
    "raw_text": {
      "selectors": [
        "[class*='price']",
        "[itemprop='price']",
        "[data-price]"
      ],
      "transform": "clean_text"
    }
  },
  "shops": {
    "mode": "multi_shop",
    "list": {
      "container": "li.p-priceList_item",
      "shop_name": ".p-priceList_shopName",
      "price": ".p-priceList_price",
      "limit": 30
    },
    "columns": [
      {
        "key": "エディオンネットショップ",
        "display": "爱电王网络商店(EDION)",
        "match": [
          "エディオン"
        ]
      },
      {
        "key": "ヨドバシ.com",
        "display": "友都八喜(Yodobashi.com)",
        "match": [
          "ヨドバシ"
        ]
      },
      {
        "key": "ヤマダウェブコム",
        "display": "山田电机网购(Yamada)",
        "match": [
          "ヤマダ"
        ]
      },
      {
        "key": "ビックカメラ.com",
        "display": "BIC CAMERA.com",
        "match": [
          "ビック"
        ]
      },
      {
        "key": "ケーズデンキ",
        "display": "K's电器(K's Denki)",
        "match": [
          "ケーズ"
        ]
      },
      {
        "key": "Joshin",
        "display": "上新电机(Joshin)",
        "match": [
          "JOSHIN"
        ]
      },
      {
        "key": "ノジマオンライン",
        "display": "Nojima 在线",
        "match": [
          "ノジマ"
        ]
      },
      {
        "key": "Amazon",
        "display": "亚马逊(Amazon)",
        "match": [
          "AMAZON"
        ]
      }
    ],
    "lowest": {
      "price": ".p-lowest_price",
      "shop": ".p-lowest_shop"
    }
  },
  "match": {
    "strategy": "url_template",
    "on_no_match": "skip",
    "verify": {
      "require_model_in": [
        "sku",
        "title"
      ]
    }
  },
  "fetch": {
    "protection": "L1_MILD",
    "requires_browser": false,
    "interval_sec": 4.0,
    "max_retries": 3,
    "nav_timeout_ms": 30000,
    "_safety_note": "安全机制：max_retries 重试上限，nav_timeout_ms 单次导航超时（毫秒），防卡死/无限重试。"
  },
  "expected": {
    "match_rate_min": 0.9,
    "price_fill_rate_min": 0.95
  },
  "paginate": {
    "reviews": {
      "max_pages": 12,
      "max_reviews": 100,
      "_note": "安全机制：max_pages 为评价翻页上限，防评价死循环。当前 capabilities 仅 price，此键为前瞻声明。"
    }
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "selectors": [
        "[itemprop='ratingValue']",
        "[class*='rating-value']",
        "[class*='avg-rating']"
      ],
      "attr": "content",
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "selectors": [
        "[itemprop='reviewCount']",
        "[class*='review-count']",
        "[class*='total-review']"
      ],
      "attr": "content",
      "transform": "int"
    }
  },
  "reviews": {
    "container": "[itemprop='review'], [class*='review-item'], [data-testid*='review'], [data-hook='review'], [class*='review-card']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id",
        "self_attr_alt": "data-review-id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']",
          "[class*='rating']",
          "[class*='star']",
          "[data-hook*='rating']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']",
          "[itemprop='name']",
          "[data-hook*='reviewTitle']",
          "h3",
          "h4"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']",
          "[class*='review-text']",
          "[data-hook*='reviewText']",
          "[data-hook*='review-body']",
          "p"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']",
          "[class*='author']",
          "[class*='reviewer']",
          ".a-profile-name"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']",
          "time",
          "[class*='review-date']",
          "[data-hook*='review-date']"
        ],
        "attr": "datetime",
        "transform": "clean_text"
      }
    },
    "media": {
      "images": {
        "selector": "img[class*='review-image'], img[data-review-image], .review-image-tile img, img[itemprop='image'], .review-media img, [class*='customer-photo'] img",
        "attr": "src",
        "exclude": [
          "avatar",
          "logo",
          "icon",
          "sprite",
          "placeholder",
          "no-image",
          "loading"
        ],
        "limit": 20
      },
      "videos": {
        "selector": "video[class*='review'], [class*='review-video'] video, [data-review-video] video, .review-media video",
        "attr": "src",
        "limit": 5
      }
    }
  }
}
